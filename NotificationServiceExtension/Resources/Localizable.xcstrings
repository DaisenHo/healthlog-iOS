    "notif.med.redacted.body": {
      "comment": "AUDIT-v0162 H2 — neutral lock-screen body shown instead of the dose text when the 'hide medication name' opt-out is on. Keeps the reminder actionable (the OS still shows the delivery time) without naming the drug.",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es ist Zeit für dein Medikament."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It's time for your medication."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "到服药时间了。"
          }
        }
      }
    }
  },
