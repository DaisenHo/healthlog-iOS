    "settings.applehealth_import.explainer": {
      "comment": "APH-IMP-stub — main explainer copy on the hero card.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Health speichert deine vollständige Historie in einer Export-ZIP. Ein einmaliger Import zieht Jahre an Vitalwerten, Aktivität und Ernährung auf einen Schlag in HealthLog. Der reguläre Apple-Health-Sync deckt nur den Zeitraum ab jetzt ab."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Health stores your full history inside an export ZIP. A one-shot import pulls years of vitals, activity and nutrition into HealthLog at once. The regular Apple Health sync only covers data from now onward."
          }
        }
      }
    },
