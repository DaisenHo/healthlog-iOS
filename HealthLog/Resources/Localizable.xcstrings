    "sessions.signOutAll.confirmBody": {
      "comment": "Sessions screen — confirm dialog body. Deliberately does NOT promise “except this device”: the server revokes every refresh token, this one included.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle Browser-Sitzungen werden beendet und alle App-Anmeldungen widerrufen. Es kann sein, dass du dich auch auf diesem Gerät neu anmelden musst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every browser session ends and every app sign-in is revoked. You may have to sign in again on this device too."
          }
        }
      }
    },
