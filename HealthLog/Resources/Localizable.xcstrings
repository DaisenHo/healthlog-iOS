    "sleep.debt.computedInfo": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das ist HealthLogs eigene Schätzung: eine gleitende Bilanz aus Bedarf minus Schlaf über die letzten Nächte, die Aufholschlaf wieder abbaut. Sie kann vom nativen Schlafdefizit eines Wearables abweichen, das ein eigenes Bedarfsmodell nutzt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This is HealthLog's own estimate: a rolling balance of need minus sleep over recent nights, with catch-up sleep paying it down. It can differ from a wearable's native sleep-debt figure, which uses its own need model."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这是 HealthLog 自行估算的结果：对近期所需睡眠与实际睡眠的差额作滚动累计，补眠会减少差额。穿戴设备使用自身的需求模型，因此原生睡眠债数值可能不同。"
          }
        }
      }
    },
    "sleep.debt.learning %lld %lld": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Schlaf wird noch erfasst: %1$lld Nächte bisher, noch %2$lld für eine verlässliche Bilanz."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Still learning your sleep: %1$lld nights so far, %2$lld more to read a reliable balance."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仍在了解你的睡眠：迄今 %1$lld 个夜晚，还要 %2$lld 个夜晚才能读出可靠的收支。"
          }
        }
      }
    },
