    "illness.correlation.recoveryGap.value": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your vitals took about %@ days to return to baseline after you felt better."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Vitalwerte brauchten etwa %@ Tage, um nach dem Besserwerden zur Baseline zurückzukehren."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在你感觉好转之后，你的生命体征大约用了 %@ 天才回到个人基线。"
          }
        }
      }
    },
    "illness.correlation.redFlags.detail %@ %lld": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "substitutions": {
            "days": {
              "argNum": 2,
              "formatSpecifier": "lld",
              "variations": {
                "plural": {
                  "one": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg day"
                    }
                  },
                  "other": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg days"
                    }
                  }
                }
              }
            }
          },
          "stringUnit": {
            "state": "translated",
            "value": "Worst %1$@ over %#@days@."
          }
        },
        "de": {
          "substitutions": {
            "days": {
              "argNum": 2,
              "formatSpecifier": "lld",
              "variations": {
                "plural": {
