    "notif.lockscreen.hideName.footer": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn aktiv, zeigen Medikamenten-Erinnerungen und die Live-Aktivität auf dem Sperrbildschirm eine allgemeine Bezeichnung statt des Medikamentennamens. Ein Blick auf dein gesperrtes Telefon verrät dann nicht, um welches Medikament es geht. Die Aktionen „Genommen“, „Später“ und „Übersprungen“ funktionieren weiterhin."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When on, medication reminders and the Live Activity show a generic label instead of the medication name on the lock screen, so a glance at your locked phone won't reveal which medication it is. The Taken, Snooze and Skip actions keep working."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "启用后，用药提醒和实时活动会在锁屏上显示通用名称，避免他人看到药名。“已服用”“稍后提醒”和“跳过”操作仍可使用。"
          }
        }
      }
    },
    "notif.lockscreen.hideName.label": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Medikamentenname verbergen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hide medication name"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "隐藏药品名称"
          }
        }
      }
    },
