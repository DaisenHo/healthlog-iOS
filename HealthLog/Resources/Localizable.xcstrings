    "measurement.reminder.footer": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ist dieser Schalter an, lässt der Server nur die Push-Nachricht auf deinen Apple-Geräten weg. Telegram, ntfy, Webhook, E-Mail und Web Push erreichen dich weiterhin, und die App plant an dieser Stelle keine eigene Erinnerung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "With this switch on, the server only leaves out the push on your Apple devices. Telegram, ntfy, webhook, email and Web Push still reach you, and the app schedules no reminder of its own in its place."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "启用此开关后，服务器仅停止向你的 Apple 设备推送。Telegram、ntfy、Webhook、邮件和网页推送仍可送达，App 不会自行安排替代提醒。"
          }
        }
      }
    },
    "measurement.reminder.title": {
