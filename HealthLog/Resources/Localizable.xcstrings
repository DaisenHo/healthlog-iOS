    "med.schedule.cadence.cyclic.explainer": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erinnert täglich in den aktiven Wochen, schweigt in den Pausenwochen. Der Zyklus zählt ab dem Kursbeginn."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fires every day during on-weeks, stays silent during off-weeks. The cycle counts from the course start."
