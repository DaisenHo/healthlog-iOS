          "stringUnit": {
            "state": "translated",
            "value": "≥ %@"
          }
        }
      }
    },
    "threshold.nudge.range.atMost %@": {
      "comment": "W-THRESHOLD-NUDGE — range with only an upper bound. %@ is the high bound.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "≤ %@"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "≤ %@"
          }
        }
      }
    },
    "threshold.nudge.settings.disclaimer": {
      "comment": "W-THRESHOLD-NUDGE — non-diagnostic disclaimer under the Settings opt-in toggle.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not medical advice. HealthLog only checks readings against the reference or target ranges from your lab results and the markers you define. It never sets its own."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine medizinische Beratung. HealthLog vergleicht Werte nur mit den Referenz- oder Zielbereichen aus deinen Laborwerten und den von dir festgelegten Markern. Eigene Grenzwerte legt die App nie fest."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不构成医疗建议。HealthLog 仅按检验结果中的参考或目标范围，以及你定义的标记检查读数，不会自行设定范围。"
          }
        }
      }
    },
    "threshold.nudge.settings.footer": {
      "comment": "W-THRESHOLD-NUDGE — Settings card footer describing the opt-in nudge.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When on, you get one calm reminder if a lab result you log falls outside its range."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn aktiv, erhältst du einen ruhigen Hinweis, falls ein erfasster Laborwert außerhalb seines Bereichs liegt."
