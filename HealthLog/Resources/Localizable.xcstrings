    "insights.ecg.intro": {
      "comment": "P8 parity — Insights ECG surface (copy contract, verbatim from the web catalogue insights.ecg.*) — REGULATORY: the recording DEVICE's own result, never a HealthLog verdict. Do NOT soften.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einkanal-EKG-Streifen, die dein Gerät aufgezeichnet hat. HealthLog zeigt nur die Aufzeichnung und das von deinem Gerät erstellte Ergebnis. Die Kurve wird nicht gelesen oder ausgewertet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Single-lead ECG strips recorded by your device. HealthLog only shows the recording and the result your device produced. It does not read or interpret the waveform."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "由你的设备记录的单导联 ECG 条带。HealthLog 只显示这段记录，以及你的设备所产生的结果。它不读取波形，也不解读波形。"
          }
        }
      }
    },
    "insights.ecg.loadError": {
      "comment": "P8 parity — Insights ECG surface (copy contract, verbatim from the web catalogue insights.ecg.*)",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine EKG-Aufzeichnungen konnten nicht geladen werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not load your ECG recordings."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法加载心电图记录。"
          }
        }
