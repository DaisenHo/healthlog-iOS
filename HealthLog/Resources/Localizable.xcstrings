    "med.criticalAlarm.failed.body": {
      "comment": "audit-release 05 C-1 — body of the critical-alarm failure warning. %@ is the list of affected medication names.",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für %@ konnte der kritische Alarm nicht aktiviert werden. Diese Erinnerung ist nicht garantiert. Bitte versuche es erneut oder prüfe die Einstellungen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The critical alarm for %@ couldn’t be set. This reminder isn’t guaranteed. Try again or check Settings."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法为 %@ 设置关键警报。这条提醒没有保证。请再试一次，或检查设置。"
          }
        }
      }
    },
    "med.criticalAlarm.failed.retry.hint": {
      "comment": "audit-release 05 C-1 — accessibility hint for the retry button on the critical-alarm failure warning.",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Versucht erneut, den kritischen Alarm zu stellen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tries to set the critical alarm again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "再次尝试设置关键警报。"
          }
        }
      }
    },
    "med.criticalAlarm.failed.title": {
      "comment": "audit-release 05 C-1 — persistent warning that a critical (life-safety) medication alarm failed to arm.",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kritischer Alarm nicht gestellt"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Critical alarm not set"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关键警报未设置"
          }
        }
      }
    },
    "med.edit.critical_alarm": {
      "comment": "v0.9.0 — medication edit sheet toggle that opts this medication into a loud AlarmKit critical alarm (iOS 26+).",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kritischer Alarm"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Critical Alarm"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关键闹钟"
          }
        }
      }
    },
    "med.edit.critical_alarm.denied": {
      "comment": "v0.9.0 — hint shown when AlarmKit authorization was denied; user must enable alarms in Settings.",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alarme sind nicht erlaubt. Aktiviere sie für HealthLog in den Einstellungen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Alarms aren’t allowed. Enable them for HealthLog in Settings."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "尚未允许闹钟权限。请在“设置”中为 HealthLog 启用。"
          }
        }
      }
    },
    "med.edit.critical_alarm.footer": {
      "comment": "v0.9.0 — one-line explanation under the Critical Alarm toggle: it breaks through Silent mode and Focus.",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Löst einen lauten Alarm aus, der Stummschaltung und Fokus durchbricht. Nur für wirklich zeitkritische Medikamente gedacht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Triggers a loud alarm that breaks through Silent mode and Focus. Intended only for genuinely time-critical medications."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "触发可穿透静音模式和专注模式的响亮闹钟，仅适用于有严格时间要求的药品。"
          }
        }
      }
    },
    "med.edit.delivery.section": {
      "comment": "v0.9.0 RA3 — header of the delivery-preferences section in the medication edit sheet (Live Activity + critical alarm).",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zustellung"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delivery"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "提醒方式"
          }
        }
      }
    },
    "med.edit.live_activity": {
      "comment": "v0.8.5 WFIX-LA — medication edit sheet toggle that opts this medication into a Live Activity (Lock-Screen + Dynamic Island dose countdown).",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Live-Aktivität"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Live Activity"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "实时活动"
          }
        }
      }
    },
    "med.edit.live_activity.footer": {
      "comment": "v0.8.5 WFIX-LA — one-line explanation under the Live Activity toggle in the medication edit sheet.",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeigt für dieses Medikament eine Live-Aktivität mit Countdown und „Genommen“-Knopf auf dem Sperrbildschirm und in der Dynamic Island. Am besten nur für zeitkritische Medikamente."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shows a Live Activity for this medication with a countdown and a “Taken” button on the Lock Screen and in the Dynamic Island. Best kept on only for time-critical medications."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在锁屏和灵动岛显示此药品的实时活动，包含倒计时和“已服用”按钮。建议仅为有严格时间要求的药品启用。"
          }
        }
      }
    },
    "med.edit.scope.all_devices": {
