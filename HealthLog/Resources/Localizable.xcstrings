    "labs.refusal.unit.unknownAnalyte": {
      "comment": "#126 P2 422 labs.unit.mismatch reason unknown_analyte.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
