      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aus deinem letzten Gesundheitsbericht übernommen. Du kannst den Namen ändern oder das Feld leer lassen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Taken from your last health report. You can change it or leave the field empty."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "取自你上一份健康报告。你可以修改它，也可以把该字段留空。"
          }
        }
      }
    },
