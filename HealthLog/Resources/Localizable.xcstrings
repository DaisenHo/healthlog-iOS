    "cycle.capture.reconcile.message": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du erfasst Blutung an einem Tag, an dem kein Zyklus läuft. Ohne Periodenbeginn wird der Eintrag dem vorherigen Zyklus zugeordnet und die Vorhersage bleibt am alten Start hängen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You are logging bleeding on a day no cycle covers. Without a period start the entry is filed against the previous cycle and the forecast stays anchored to the old start."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你正在一个没有任何生理周期覆盖的日子记录出血。如果没有经期开始，这条记录会归入上一个生理周期，而预测仍锚定在原来的开始日期上。"
          }
        }
      }
    },
