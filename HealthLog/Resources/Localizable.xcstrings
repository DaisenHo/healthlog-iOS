    "threshold.nudge.body.above %@ %@ %@": {
      "comment": "W-THRESHOLD-NUDGE — factual out-of-range body (above). %1$@ analyte, %2$@ value+unit, %3$@ range. NON-diagnostic: states a fact only, no advice/diagnosis/reassurance.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your %1$@ reading of %2$@ is above the range you set (%3$@)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein %1$@-Wert von %2$@ liegt über dem von dir festgelegten Bereich (%3$@)."
          }
        }
      }
    },
    "threshold.nudge.body.below %@ %@ %@": {
      "comment": "W-THRESHOLD-NUDGE — factual out-of-range body (below). %1$@ analyte, %2$@ value+unit, %3$@ range. NON-diagnostic: states a fact only, no advice/diagnosis/reassurance.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your %1$@ reading of %2$@ is below the range you set (%3$@)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein %1$@-Wert von %2$@ liegt unter dem von dir festgelegten Bereich (%3$@)."
          }
        }
      }
    },
    "threshold.nudge.disclaimer": {
      "comment": "W-THRESHOLD-NUDGE — standing non-diagnostic disclaimer appended to every nudge body. Not medical advice.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Informational only, not medical advice."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Informativer Hinweis, kein medizinischer Rat."
          }
        }
      }
    },
    "threshold.nudge.range.atLeast %@": {
      "comment": "W-THRESHOLD-NUDGE — range with only a lower bound. %@ is the low bound.",
