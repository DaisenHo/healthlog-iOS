    "settings.applehealth.medSync.error.unstableExternalId": {
      "comment": "CU-10 — pre-flight refusal when a mirror create carries an unstable externalId",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Apple-Health-Medikament hat keine stabile Kennung und wurde nicht gespiegelt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This Apple Health medication has no stable identifier and was not mirrored."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此 Apple 健康药品没有稳定标识符，未能镜像同步。"
          }
        }
      }
    },
    "settings.applehealth.medSync.footer": {
      "comment": "GH #47 — Apple Health medications sync toggle footer",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Spiegelt deine Apple-Health-Medikamente und protokollierten Dosen (nur lesen). Bei gespiegelten Medikamenten ist die manuelle Dosis-Erfassung deaktiviert, um Doppelzählungen zu vermeiden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mirror your Apple Health medications and their logged doses (read-only). Manual dose logging is disabled on a mirrored medication to avoid double-counting."
          }
        }
      }
    },
    "settings.applehealth.medSync.issue.limitReached": {
      "comment": "CU-10 — Apple Health mirror growth cap reached (server medications.mirror.limit_exceeded)",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Health enthält mehr Medikamente, als HealthLog spiegelt. Die Obergrenze für gespiegelte Medikamente ist erreicht: Bereits gespiegelte Medikamente werden weiter synchronisiert, neue kommen nicht mehr dazu."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Health holds more medications than HealthLog mirrors. The limit for mirrored medications is reached. Medications already mirrored keep syncing, new ones are no longer added."
          }
        }
      }
    },
    "settings.applehealth.medSync.issue.unstableExternalId": {
      "comment": "CU-10 — server refused an externalId as unstable (unstable_external_id)",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Medikament aus Apple Health konnte nicht eindeutig zugeordnet werden und wurde nicht gespiegelt. Die Synchronisation läuft weiter. Bitte melde es, falls das bestehen bleibt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A medication from Apple Health couldn't be identified reliably and was not mirrored. Syncing continues. Please report it if this persists."
          }
        }
      }
    },
    "settings.applehealth.medSync.label": {
      "comment": "GH #47 — Apple Health medications sync toggle title",
      "extractionState": "manual",
      "localizations": {
