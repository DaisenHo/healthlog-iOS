    "notifications.content.footer": {
      "comment": "#126 3.3 footer explaining generic vs detailed.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aus sagt eine Mitteilung nur, worum es geht. An kann sie Werte zeigen, etwa deinen Score im Morgenbriefing."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Off, a notification only says what it is about. On, it can show figures, such as your score in the morning briefing."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭时，通知只显示主题；开启后可显示数值，例如晨间简报中的评分。"
          }
        }
      }
