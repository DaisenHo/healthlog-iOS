    "mentalHealth.functionalTitle": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn du eine oder mehrere Beschwerden angegeben hast: Wie sehr haben diese deine Arbeit, deinen Haushalt oder den Umgang mit anderen Menschen erschwert?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If you checked off any problems, how difficult have these made it to do your work, take care of things at home, or get along with other people?"
          }
        }
      }
    },
