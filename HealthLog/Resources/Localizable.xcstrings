            "value": "Enable assistant insight"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "启用助手分析"
          }
        }
      }
    },
    "insights.metric.assessment.noProvider.title": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Assistent-Befund nicht aktiviert"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Assistant insights disabled"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
