    "mentalHealth.historyLoadErrorHint": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das heißt nicht, dass keine Ergebnisse vorliegen. Die Liste konnte nur nicht abgerufen werden. Versuche es erneut."
          }
        },
        "en": {
