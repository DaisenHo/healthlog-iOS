    "dashboard.intakesSheet.action.markTaken": {
      "comment": "v0.6.1.7 Y7 — VoiceOver label on the empty-circle tap target for a pending intake row. Activating the button marks the dose as taken; the visible glyph is an empty circle (no Haken until the operator confirms the dose).",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch nicht genommen, antippen zum Markieren"
          }
        },
