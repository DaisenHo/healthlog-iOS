    "integration.connectProvider": {
      "comment": "Integration connect button label; %@ is the provider name.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ verbinden"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
