    "sources.methodTitle.correlations": {
      "comment": "1.4.1 methodology title",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zusammenhänge in deinen Daten"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Relationships in your data"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你数据中的关联"
          }
        }
      }
    },
    "sources.method.correlations": {
      "comment": "1.4.1 methodology",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Zusammenhangs-Karte vergleicht einen deiner Tageswerte (zum Beispiel Schlafdauer) mit einem anderen Wert am Folgetag (zum Beispiel diastolischer Blutdruck), Tag für Tag, über deine eigene Historie. HealthLog berechnet auf diesen Tagespaaren den Pearson-Korrelationskoeffizienten r. Ein Paar erscheint nur, wenn mindestens 20 gepaarte Tage vorliegen, der zweiseitige p-Wert unter 0,05 liegt und es die Benjamini-Hochberg-Kontrolle der Falschentdeckungsrate bei q = 0,10 über alle geprüften Paare übersteht. Die Stärke folgt |r|: unter 0,3 schwach, unter 0,5 mittel, sonst stark. Kleine Stichproben werden Richtung null geschrumpft, damit wenige Tage kein stark wirkendes r erzeugen. Das sind statistische Zusammenhänge in deinen eigenen Aufzeichnungen: keine Ursachen, keine Bevölkerungsbefunde und nie ein Grund, ein Medikament zu ändern."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A relationship card compares one of your daily values (for example sleep duration) with another value on the following day (for example diastolic blood pressure), day by day, over your own history. HealthLog computes the Pearson correlation coefficient r on those day-pairs. A pair is shown only if at least 20 paired days exist, the two-sided p-value is below 0.05, and it survives the Benjamini-Hochberg false-discovery control at q = 0.10 across all pairs tested. Strength labels follow |r|: below 0.3 weak, below 0.5 moderate, otherwise strong. Small samples are shrunk toward zero so a handful of days cannot produce a strong-looking r. These are statistical associations in your own records: not causes, not population findings, and never a reason to change a medication."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一张关系卡片把你的一项每日数值（例如睡眠时长）与下一天的另一项数值（例如舒张压）逐日比较，贯穿你自己的历史。HealthLog 在这些日配对上计算 Pearson 相关系数 r。一个配对只有在同时满足以下条件时才会显示：至少存在 20 个配对日，双侧 p 值低于 0.05，并且它在全部受检配对中通过了 q = 0.10 的 Benjamini-Hochberg 错误发现控制。强度标签遵循 |r|：低于 0.3 为弱，低于 0.5 为中等，否则为强。小样本会向零收缩，因此仅仅几天不能产生一个看起来很强的 r。这些是你自己记录中的统计关联：不是原因，不是人群发现，也绝不是更改一种药物的理由。"
          }
        }
      }
    },
    "sources.methodTitle.healthScore": {
      "comment": "1.4.1 methodology title",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Health Score"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Health Score"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "健康评分"
          }
        }
      }
    },
    "sources.method.healthScore": {
      "comment": "1.4.1 methodology",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Health Score ist HealthLogs eigener Wert von 0 bis 100 aus bis zu acht Säulen: Blutdruck, Blutzucker, Aktivität, Schlaf, Taille, Wohlbefinden, Fitness und Blutfette. Jede Säule vergleicht deine jüngsten Werte mit den unten genannten Referenzbändern; Säulen ohne ausreichende Daten entfallen, die übrigen Gewichte werden neu skaliert. Er ist eine Zusammenfassung zur Orientierung, kein klinischer Risiko-Score und nicht an Krankheitsverläufen validiert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Health Score is HealthLog's own composite from 0 to 100, built from up to eight pillars: blood pressure, blood sugar, activity, sleep, waist, wellbeing, fitness and blood lipids. Each pillar compares your recent values with the reference bands listed below; pillars without enough data are left out and the remaining weights are rescaled. It is a summary for orientation, not a clinical risk score and not validated against outcomes."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "健康评分是 HealthLog 自己的综合值，从 0 到 100，由最多八个支柱构成：血压、血糖、活动、睡眠、腰围、身心安适、体能和血脂。每一个支柱把你最近的数值与下方列出的参考带相比较；数据不足的支柱会被留出，其余的权重会重新缩放。它是一份用于定向的摘要，不是临床风险评分，也没有对照结局进行过验证。"
          }
        }
      }
    },
    "sources.methodTitle.derivedScores": {
      "comment": "1.4.1 methodology title",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Readiness, Schlaf, Erholung, Stress, Belastung, Fitness- und Gefäßalter"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Readiness, sleep, recovery, stress, strain, fitness and vascular age"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Readiness、睡眠、恢复、压力、负荷、体能年龄与血管年龄"
          }
        }
      }
    },
    "sources.method.derivedScores": {
      "comment": "1.4.1 methodology",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Scores sind beschreibende Näherungswerte aus deiner eigenen Baseline: Ruhepuls, Herzratenvariabilität, Schlaf und Aktivität werden mit deinem üblichen Bereich der letzten Wochen verglichen und zu einem Wert von 0 bis 100 verrechnet. Das Fitnessalter nutzt deine VO₂max-Schätzung; das Gefäßalter ordnet einen Wert ein, den dein Gerät berechnet. Keiner davon ist eine Diagnose, eine trainingswissenschaftliche Messung oder eine EDA-Stressmessung; die nächtliche HRV einer Smartwatch ist nicht mit klinischen 24-Stunden-Normwerten vergleichbar."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "These scores are descriptive proxies computed from your own baseline: resting heart rate, heart-rate variability, sleep and activity are compared with your usual range over recent weeks and blended into a value from 0 to 100. Fitness age uses your VO₂max estimate; vascular age re-frames a value your device computes. None of them is a diagnosis, a training-grade measurement or an EDA stress reading; a wearable's overnight HRV is not comparable to clinical 24-hour norms."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这些评分是根据你自己的个人基线计算出来的描述性代理值：静息心率、心率变异性、睡眠和活动会与你最近数周的惯常范围相比较，并合成为一个从 0 到 100 的数值。体能年龄使用你的 VO₂max 估计；血管年龄重新表述一个由你的设备计算的数值。它们之中没有一个是诊断，没有一个是训练级测量，也没有一个是 EDA 应激读数；可穿戴设备的夜间 HRV 不能与临床 24 小时常模相比较。"
          }
        }
      }
    },
    "sources.methodTitle.rangeBands": {
      "comment": "1.4.1 methodology title",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Im Bereich“ und Zielbänder"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“In range” and target bands"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“在范围内”与目标区间"
          }
        }
      }
    },
    "sources.method.rangeBands": {
      "comment": "1.4.1 methodology",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Zielband einer Kachel ist entweder ein Bereich, den du selbst gesetzt hast, ein Bereich aus deinem eigenen Laborbefund oder ein allgemeines Erwachsenen-Referenzband aus den hier genannten Leitlinien. „Tage im Bereich“ zählt deine Messwerte innerhalb dieses Bandes. Farbe ist nur eine Lesehilfe: ein Wert außerhalb ist eine Information, kein Alarm."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A tile's target band is either a range you set yourself, a range from your own lab result, or a general adult reference band from the guidelines listed on this page. “Days in range” counts your readings inside that band. Colour is only a reading aid: a value outside the band is information, not an alarm."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一块磁贴的目标带，要么是你自己设置的范围，要么是来自你自己检验结果的范围，要么是本页所列指南中的一般成人参考带。“范围内天数”统计落在该带之内的测量。颜色只是阅读辅助：带外的数值是一条信息，不是警报。"
          }
        }
      }
    },
    "sources.methodTitle.metricExplainer": {
      "comment": "1.4.1 methodology title",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Metrik-Erklärungen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Metric explanations"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "指标说明"
          }
        }
      }
    },
    "sources.method.metricExplainer": {
      "comment": "1.4.1 methodology",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die kurze Erklärung auf jeder Metrik-Seite beschreibt, was der Wert ist und wie ein typischer Erwachsenen-Bereich aussieht. Die typischen Bereiche stammen aus den Referenzen unten; die individuelle Streuung ist groß, und deine eigene Baseline zählt mehr als eine Bevölkerungszahl."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The short explanation on each metric page describes what the value is and what a typical adult range looks like. The typical ranges come from the references below; individual variation is wide and your own baseline matters more than a population number."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每个指标页面上的简短说明，描述这个数值是什么，以及典型的成人范围是什么样。典型范围来自下方的参考文献；个体差异很大，你自己的个人基线比一个人群数字更重要。"
          }
        }
      }
    },
    "sources.methodTitle.bpClassification": {
      "comment": "1.4.1 methodology title",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Blutdruck-Einordnung"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Blood-pressure classification"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "血压分类"
          }
        }
      }
    },
    "sources.method.bpClassification": {
      "comment": "1.4.1 methodology",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Chip auf der Blutdruck-Seite nutzt die ESH-2023-Kategorien (optimal, normal, hochnormal, Hypertonie Grad 1 bis 3) auf deinem 30-Tage-Mittel. Die US-Dokumente ACC/AHA 2017 und ESC 2024 ziehen die Grenzen anders; sie sind zum Vergleich aufgeführt. Eine Kategorie aus Heimmessungen ist keine Diagnose. Dafür braucht es wiederholte, korrekt durchgeführte Messungen und ärztliche Beurteilung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The chip on the blood-pressure page uses the ESH 2023 categories (optimal, normal, high-normal, hypertension grade 1 to 3) applied to your 30-day average. The US ACC/AHA 2017 and ESC 2024 documents draw the lines differently; they are listed for comparison. A category from home readings is not a diagnosis. That needs repeated, properly taken measurements and a clinician."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "血压页面上的标签使用 ESH 2023 的分类（最佳、正常、正常高值、高血压 1 至 3 级），用在你的 30 天平均上。美国的 ACC/AHA 2017 和 ESC 2024 文件画的界线并不相同；把它们列出来是为了对照。来自家庭测量的一个类别不是诊断。那需要反复进行、操作规范的测量，以及一位临床人员。"
          }
        }
      }
    },
    "sources.methodTitle.pulsePressureMAP": {
      "comment": "1.4.1 methodology title",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Pulsdruck und mittlerer arterieller Druck"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pulse pressure and mean arterial pressure"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "脉压与平均动脉压"
          }
        }
      }
    },
    "sources.method.pulsePressureMAP": {
      "comment": "1.4.1 methodology",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Pulsdruck ist systolisch minus diastolisch; der mittlere arterielle Druck ist diastolisch plus ein Drittel des Pulsdrucks. Beide sind aus deiner letzten Messung abgeleitet, nicht gemessen. Die „typischen“ Zahlen sind physiologische Lehrbuchwerte, brauchbar als Gesprächsanlass mit Ärztin oder Arzt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pulse pressure is systolic minus diastolic; mean arterial pressure is diastolic plus one third of the pulse pressure. Both are derived from your last reading, not measured. The “typical” figures are textbook physiology values, useful as a conversation starter with a clinician."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "脉压是收缩压减去舒张压；平均动脉压是舒张压加上脉压的三分之一。两者都由你最近一次测量推算而来，并不是测得的。这些“典型”数字是生理学教科书中的数值，适合作为与临床人员交谈的起点。"
          }
        }
      }
    },
    "sources.methodTitle.bmi": {
      "comment": "1.4.1 methodology title",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "BMI und Taille"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "BMI and waist"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "BMI和腰围"
          }
        }
      }
    },
    "sources.method.bmi": {
      "comment": "1.4.1 methodology",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die BMI-Klassen folgen den WHO-2000-Grenzen (18,5, 25, 30, 35, 40 kg/m²). Der BMI ist ein Bevölkerungs-Screening: er unterscheidet nicht Muskel von Fett, und die Risikogrenzen unterscheiden sich zwischen Bevölkerungsgruppen. Taillenmaße folgen dem WHO-Bericht 2011."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "BMI classes follow the WHO 2000 cut-offs (18.5, 25, 30, 35, 40 kg/m²). BMI is a population screen: it does not distinguish muscle from fat and the risk cut-offs differ between populations. Waist measurements follow the WHO 2011 report."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "BMI 分级遵循 WHO 2000 的切点（18.5、25、30、35、40 kg/m²）。BMI 是一项人群筛查：它不区分肌肉和脂肪，而且风险切点在不同人群之间并不相同。腰围测量遵循 WHO 2011 报告。"
          }
        }
      }
    },
    "sources.methodTitle.healthStatus": {
      "comment": "1.4.1 methodology title",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Abweichungen und anhaltende Verschiebungen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Deviations and sustained shifts"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "偏离与持续变化"
          }
        }
      }
    },
    "sources.method.healthStatus": {
      "comment": "1.4.1 methodology",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Abweichung heißt, dass ein aktueller Wert außerhalb der Streuung deiner eigenen vorangegangenen Wochen liegt; eine anhaltende Verschiebung heißt, dass ein Änderungspunkt-Detektor eine bleibende Niveauänderung in deiner Reihe gefunden hat. Beides vergleicht dich mit dir selbst, nicht mit einer Bevölkerung; beides sind Anlässe hinzusehen, keine Befunde."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A deviation means a recent value sits outside the spread of your own preceding weeks; a sustained shift means a change-point detector found a lasting level change in your series. Both compare you with yourself, not with a population; both are prompts to look, not findings."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "偏离是指一个最近的数值落在你自己此前数周的离散范围之外；持续偏移是指一个变点检测器在你的序列中发现了持久的水平变化。两者比较的都是你和你自己，不是你和某个人群；两者都是促使你去看的提示，不是发现。"
          }
        }
      }
    },
    "sources.methodTitle.sleepRhythm": {
      "comment": "1.4.1 methodology title",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schlafdefizit, Chronotyp und sozialer Jetlag"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sleep debt, chronotype and social jetlag"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "睡眠债、睡眠时型与社交时差"
          }
        }
      }
    },
    "sources.method.sleepRhythm": {
      "comment": "1.4.1 methodology",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Schlafdefizit ist HealthLogs rollierende Bilanz aus einem 7-Stunden-Bedarf minus dem Schlaf der letzten Nächte. Der Chronotyp ist die Schlafmitte an freien Tagen, um den Nachholschlaf der Arbeitstage bereinigt (MSFsc, Roenneberg); sozialer Jetlag ist der Abstand zwischen Schlafmitte an Arbeits- und freien Tagen (Wittmann). Schlafregelmäßigkeit folgt Phillips 2017. Alles beschreibend."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sleep debt is HealthLog's rolling balance of a 7-hour need minus the sleep you got over recent nights. Chronotype is the mid-sleep time on free days corrected for weekday catch-up (MSFsc, Roenneberg); social jetlag is the gap between workday and free-day mid-sleep (Wittmann). Sleep regularity follows Phillips 2017. All are descriptive."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "睡眠债是 HealthLog 的滚动收支，用 7 小时的需求减去你最近几个夜晚实际得到的睡眠。时型是自由日的睡眠中点，并已校正工作日的补觉（MSFsc，Roenneberg）；社交时差是工作日与自由日睡眠中点之间的差距（Wittmann）。睡眠规律性遵循 Phillips 2017。这些全部是描述性的。"
          }
        }
      }
    },
    "sources.methodTitle.breathing": {
      "comment": "1.4.1 methodology title",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Atmungsstörungen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Breathing disturbances"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "呼吸紊乱"
          }
        }
      }
    },
    "sources.method.breathing": {
      "comment": "1.4.1 methodology",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Atmungs-Screening-Karte gibt eine Einordnung wieder, die dein Gerät über rund 30 Nächte berechnet hat. HealthLog wertet das Signal nicht selbst aus. Wie die Funktion arbeitet und was sie nicht erkennt, steht in der Gerätedokumentation."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The breathing-screening card repeats a classification your device computed over roughly 30 nights. HealthLog does not analyse the signal itself. See the device documentation for how the feature works and what it cannot detect."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "呼吸筛查卡片复述的是你的设备在大约 30 个夜晚里计算出来的分类。HealthLog 并不自己分析这个信号。该功能如何工作，以及它不能检测什么，请参阅设备文档。"
          }
        }
      }
    },
    "sources.methodTitle.ecgRhythm": {
      "comment": "1.4.1 methodology title",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "EKG und Rhythmus-Hinweise"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "ECG and rhythm notifications"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "ECG 与心律提示"
          }
        }
      }
    },
    "sources.method.ecgRhythm": {
      "comment": "1.4.1 methodology",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "EKG-Ergebnisse sowie Hinweise auf unregelmäßigen Rhythmus, hohen oder niedrigen Puls stammen von deinem Aufzeichnungsgerät und werden so angezeigt, wie sie aufgezeichnet wurden. HealthLog liest die Kurve nicht und ordnet sie nicht neu ein."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "ECG results and irregular-rhythm, high- or low-heart-rate notices are produced by your recording device and shown as recorded. HealthLog neither reads the waveform nor re-classifies it."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "ECG 结果，以及不规则心律、心率偏高或心率偏低的提示，都由你的记录设备产生，并按记录原样显示。HealthLog 既不读取波形，也不重新分类。"
          }
        }
      }
    },
    "sources.methodTitle.medicationCompliance": {
      "comment": "1.4.1 methodology title",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Medikamenten-Therapietreue"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Medication compliance"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用药依从性"
          }
        }
      }
    },
    "sources.method.medicationCompliance": {
      "comment": "1.4.1 methodology",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Therapietreue ist der Anteil geplanter Dosen, die du als genommen markiert hast, aus dem Dosis-Ledger deines Servers. Die Ringfarben (70 % und 40 %) sind HealthLogs eigene Lesehilfe, keine klinische Adhärenz-Schwelle."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Compliance is the share of scheduled doses you marked as taken, from your server's dose ledger. The ring colours (70 % and 40 %) are HealthLog's own reading aid, not a clinical adherence threshold."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "依从性是你标为已服用的计划剂量所占的比例，来自你服务器上的剂量账本。环的颜色（70% 和 40%）是 HealthLog 自己的阅读辅助，不是临床依从性阈值。"
          }
        }
      }
    },
    "sources.methodTitle.glp1PK": {
      "comment": "1.4.1 methodology title",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Geschätzter Wirkstoffspiegel"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Estimated drug level"
          }
        }
      }
    },
    "sources.method.glp1PK": {
      "comment": "1.4.1 methodology",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Kurve ist ein Ein-Kompartiment-Lehrmodell auf Basis der Populations-Halbwertszeit und Resorptionsangaben aus der EMA-Produktinformation deines Wirkstoffs. Sie ist absichtlich einheitenlos und misst nichts in deinem Blut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The curve is a one-compartment educational model driven by the population half-life and absorption figures in the EMA product information for your drug. It is unit-less on purpose and is not a measurement of anything in your blood."
          }
        }
      }
    },
    "sources.methodTitle.titration": {
      "comment": "1.4.1 methodology title",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Titrationsschema"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Titration schedule"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "滴定方案"
          }
        }
      }
    },
    "sources.method.titration": {
      "comment": "1.4.1 methodology",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das gezeigte Schema ist das Standard-Steigerungsschema des Herstellers aus der EMA-Produktinformation (Abschnitt 4.2), nur bis zu der Dosis, die du erfasst hast. Das ist Information über die Zulassung, kein Rat, deine Dosis zu ändern. Das entscheidest du mit deiner verschreibenden Ärztin oder deinem Arzt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The schedule shown is the manufacturer's standard escalation from the EMA product information (section 4.2), drawn only up to the dose you have recorded. It is information about the label, not advice to change your dose. That is a decision for you and your prescriber."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所显示的方案，是制造商在 EMA 产品信息（第 4.2 节）中的标准递增方案，而且只绘制到你已经记录的剂量为止。这是关于说明书的信息，不是建议你更改剂量。那是由你和你的处方者作出的决定。"
          }
        }
      }
    },
    "sources.methodTitle.injectionRotation": {
      "comment": "1.4.1 methodology title",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Rotation der Injektionsstellen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Injection-site rotation"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "注射部位轮换"
          }
        }
      }
    },
    "sources.method.injectionRotation": {
      "comment": "1.4.1 methodology",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die vorgeschlagene Stelle ist die, die du im Rotationsfenster am längsten nicht genutzt hast. Der Wechsel subkutaner Injektionsstellen ist Standard der Injektionstechnik zur Vermeidung von Lipohypertrophie; auch die Produktinformation verlangt ihn."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The suggested site is the one you used least recently within the rotation window. Rotating subcutaneous injection sites is standard injection-technique guidance to avoid lipohypertrophy; the product information asks for it as well."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "建议的部位是你在轮换窗口内最久没有使用的那一处。轮换皮下注射部位是标准的注射技术指引，用以避免脂肪增生；产品信息也同样要求这样做。"
          }
        }
      }
    },
    "sources.methodTitle.glucoseTargets": {
      "comment": "1.4.1 methodology title",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Glukose-Ziele"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Glucose targets"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "血糖目标"
          }
        }
      }
    },
    "sources.method.glucoseTargets": {
      "comment": "1.4.1 methodology",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ohne den Diabetes-Schalter wird Glukose mit der WHO/IDF-Nüchternreferenz verglichen. Mit ihm gelten die engeren ADA-2024-Glykämieziele (nüchtern 80 bis 130 mg/dL, nach Mahlzeiten unter 180 mg/dL). Deine eigenen vereinbarten Ziele gehen immer vor."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Without the diabetes switch, glucose is compared with the WHO/IDF fasting reference. With it, the tighter ADA 2024 glycaemic targets apply (fasting 80 to 130 mg/dL, after meals below 180 mg/dL). Your own agreed targets always take precedence."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有打开糖尿病开关时，血糖与 WHO/IDF 的空腹参考相比较。打开之后，适用更严格的 ADA 2024 血糖目标（空腹 80 至 130 mg/dL，餐后低于 180 mg/dL）。你自己已经商定的目标始终优先。"
          }
        }
      }
    },
    "sources.methodTitle.labBiomarker": {
      "comment": "1.4.1 methodology title",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Laborwert-Erklärungen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lab-value explanations"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "检验数值说明"
          }
        }
      }
    },
    "sources.method.labBiomarker": {
      "comment": "1.4.1 methodology",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jede Erklärung beschreibt, was der Marker misst und welche Richtung üblicherweise besprechenswert ist, nach den Referenzen unten. Ob dein Wert im Bereich liegt, entscheidet das Referenzintervall auf deinem eigenen Laborbefund, das HealthLog unverändert übernimmt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each explanation describes what the marker measures and which direction is usually worth discussing, following the references below. Whether your value is in range is decided by the reference interval printed on your own lab report, which HealthLog uses as given."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每一条说明都描述该标志物测量的是什么，以及哪个方向通常值得讨论，依据是下方的参考文献。你的数值是否在范围内，由你自己的检验报告上印出的参考区间决定，HealthLog 按原样使用该区间。"
          }
        }
      }
    },
    "sources.methodTitle.labReferenceRanges": {
      "comment": "1.4.1 methodology title",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vorausgefüllte Referenzbereiche"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pre-filled reference ranges"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "预填的参考范围"
          }
        }
      }
    },
    "sources.method.labReferenceRanges": {
      "comment": "1.4.1 methodology",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn du einen Marker anlegst, füllt HealthLog einen gängigen Erwachsenen-Referenzbereich als Startwert vor (zum Beispiel LDL ≤ 116 mg/dL nach ESC/EAS 2019, HbA1c < 5,7 % nach ADA, eGFR ≥ 90 nach KDIGO, allgemeine Chemie nach dem ABIM-Referenzblatt). Bereiche unterscheiden sich nach Labor, Methode, Geschlecht und Alter. Ersetze sie durch die auf deinem Befund."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When you define a marker, HealthLog pre-fills a common adult reference range as a starting point (for example LDL ≤ 116 mg/dL from ESC/EAS 2019, HbA1c < 5.7 % from ADA, eGFR ≥ 90 from KDIGO, general chemistry from the ABIM reference sheet). Ranges differ by laboratory, method, sex and age. Replace them with the ones on your report."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当你定义一个标志物时，HealthLog 会预填一个常见的成人参考范围作为起点（例如来自 ESC/EAS 2019 的 LDL ≤ 116 mg/dL，来自 ADA 的 HbA1c < 5.7%，来自 KDIGO 的 eGFR ≥ 90，一般化学来自 ABIM 参考表）。范围因实验室、方法、性别和年龄而不同。请用你报告上的范围替换它们。"
          }
        }
      }
    },
    "sources.methodTitle.mentalHealth": {
      "comment": "1.4.1 methodology title",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wohlbefindens-Fragebögen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Wellbeing questionnaires"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "幸福感问卷"
          }
        }
      }
    },
    "sources.method.mentalHealth": {
      "comment": "1.4.1 methodology",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "PHQ-9, GAD-7, WHO-5 und der Sleep Condition Indicator sind veröffentlichte Screening-Instrumente; HealthLog nutzt ihre Originalfragen und die Grenzwerte aus den unten genannten Validierungsstudien (PHQ-9/GAD-7-Bänder 5/10/15/20, WHO-5 ≤ 50, SCI ≤ 16). Ein Screening-Wert ist keine Diagnose. Die kann nur qualifiziertes Fachpersonal stellen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "PHQ-9, GAD-7, WHO-5 and the Sleep Condition Indicator are published screening instruments; HealthLog uses their original items and the cut-offs from the validation papers below (PHQ-9/GAD-7 bands 5/10/15/20, WHO-5 ≤ 50, SCI ≤ 16). A screening score is not a diagnosis. Only a qualified professional can make one."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "PHQ-9、GAD-7、WHO-5 和 Sleep Condition Indicator 是已发表的筛查工具；HealthLog 使用它们的原始题目，以及下方验证论文中的切点（PHQ-9/GAD-7 档位 5/10/15/20，WHO-5 ≤ 50，SCI ≤ 16）。筛查评分不是诊断。只有合格的专业人员才能作出诊断。"
          }
        }
      }
    },
    "sources.methodTitle.personalRecords": {
      "comment": "1.4.1 methodology title",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vergleichsbereiche bei Bestwerten"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Comparison ranges on personal records"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "最佳值的比较范围"
          }
        }
      }
    },
    "sources.method.personalRecords": {
      "comment": "1.4.1 methodology",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Vergleichsband setzt deinen Bestwert gegen einen Bevölkerungsmittelwert ± eine Standardabweichung aus den unten genannten Erhebungen und Tabellen. Es beantwortet „ist das typisch?“, nicht „ist das gesund?“."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The comparison band places your best value against a population mean ± one standard deviation from the surveys and charts below. It answers “is this typical?”, not “is this healthy?”."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "比较带把你的最佳数值，对照下方调查和图表中的人群均值 ± 一个标准差。它回答的是“这典型吗？”，不是“这健康吗？”。"
          }
        }
      }
    },
    "sources.methodTitle.nutrition": {
      "comment": "1.4.1 methodology title",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nährstoff-Referenzwerte"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nutrient reference values"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "营养素参考数值"
          }
        }
      }
    },
    "sources.method.nutrition": {
      "comment": "1.4.1 methodology",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tägliche Nährstoffziele sind die EFSA-Referenzwerte für Erwachsene (Population Reference Intake, Adequate Intake oder Upper Level, wie beschriftet). Die Zufuhrdaten kommen aus Apple Health."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Daily nutrient targets are the EFSA Dietary Reference Values for adults (population reference intake, adequate intake or upper level, as labelled). Intake data comes from Apple Health."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每日营养素目标是面向成人的 EFSA 膳食参考值（人群参考摄入量、适宜摄入量或上限，依所标示的为准）。摄入数据来自 Apple Health。"
          }
        }
      }
    },
    "sources.methodTitle.cycle": {
      "comment": "1.4.1 methodology title",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zyklusphasen und Vorhersagen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cycle phases and predictions"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "生理周期阶段与预测"
          }
        }
      }
    },
    "sources.method.cycle": {
      "comment": "1.4.1 methodology",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Phasen-Erklärungen beschreiben die typische Physiologie; Vorhersagen sind Kalenderschätzungen aus deinen erfassten Zyklen. Das fruchtbare Fenster schwankt stark zwischen und innerhalb von Personen (Wilcox 2000). Nichts davon ist Verhütung oder medizinischer Rat."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase explanations describe typical physiology; predictions are calendar estimates from your logged cycles. The fertile window varies widely between and within people (Wilcox 2000). Nothing here is contraception or medical advice."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "阶段说明描述的是典型生理；预测是根据你所记录的生理周期作出的日历估计。易孕窗口在不同的人之间，以及同一个人自身之内，差异都很大（Wilcox 2000）。这里的任何内容都不是避孕，也不是医疗建议。"
          }
        }
      }
    },
    "sources.methodTitle.mood": {
      "comment": "1.4.1 methodology title",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stimmung und Faktoren"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mood and factors"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "心情与因素"
          }
        }
      }
    },
    "sources.method.mood": {
      "comment": "1.4.1 methodology",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stimmungskarten vergleichen deine durchschnittliche Stimmung an Tagen mit und ohne einen Tag oder Faktor, aus deinen eigenen Einträgen. Das sind Zusammenhänge, keine Ursachen, und es kommt keine klinische Skala zum Einsatz."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mood cards compare your average mood on days with and without a tag or factor, from your own entries. They are associations, not causes, and use no clinical scale."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "心情卡片比较的是你在有某个标签或因素的日子与没有的日子里的平均心情，数据来自你自己的记录。它们是关联，不是原因，并且不使用临床量表。"
          }
        }
      }
    },
    "sources.methodTitle.illnessRecovery": {
      "comment": "1.4.1 methodology title",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Krankheitsepisoden und Erholung"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Illness episodes and recovery"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "疾病病程与恢复"
          }
        }
      }
    },
    "sources.method.illnessRecovery": {
      "comment": "1.4.1 methodology",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Während einer Episode werden deine Vitalwerte mit deiner eigenen Baseline aus den Wochen davor verglichen; die Erholungslücke ist die Zahl der Tage, bis sie dorthin zurückkehren. „Genauer hinsehen“ markiert ein Muster in deinen Daten, keinen klinischen Befund. Wiederkehrende Beschwerden gehören zu Ärztin oder Arzt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "During an episode your vitals are compared with your own baseline from the weeks before; the recovery gap is the number of days until they return to it. “Worth a closer look” flags a pattern in your data, not a clinical finding. Recurring symptoms belong with a clinician."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在一次病程期间，你的生命体征会与前几周你自己的个人基线相比较；恢复间隔是它们回到该基线所需要的天数。“值得再看一看”标出的是你数据中的一种模式，不是临床发现。反复出现的症状应交给临床人员。"
          }
        }
      }
    },
    "sources.methodTitle.aiAssistant": {
      "comment": "1.4.1 methodology title",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Assistent, Briefing und Einschätzungen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Assistant, briefing and assessments"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "助手、简报与评估"
          }
        }
      }
    },
    "sources.method.aiAssistant": {
      "comment": "1.4.1 methodology",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einschätzungen, das tägliche Briefing und Coach-Antworten sind generierter Text (auf deinem Gerät, von deinem eigenen Anbieter oder deinem Server) auf Basis deiner eigenen Werte und der unten aufgeführten Referenzen. Er kann falsch sein. Er ist beschreibend, nie eine Diagnose und nie ein Grund, eine Behandlung ohne ärztliche Rücksprache zu ändern."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Assessments, the daily briefing and coach answers are generated text (on your device, by your own provider, or by your server), grounded in your own values and in the published references listed below. They can be wrong. They are descriptive, never a diagnosis, and never a reason to change treatment without a clinician."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "评估、每日简报和教练的回答都是生成的文本（在你的设备上，由你自己的提供方，或由你的服务器生成），依据的是你自己的数值，以及下方列出的已发表参考文献。它们可能是错的。它们是描述性的，绝不是诊断，也绝不是在没有临床人员的情况下更改治疗的理由。"
          }
        }
      }
    },
    "sources.methodTitle.vorsorge": {
      "comment": "1.4.1 methodology title",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vorsorge"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Preventive care"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "预防保健"
          }
        }
      }
    },
    "sources.method.vorsorge": {
      "comment": "1.4.1 methodology",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vorsorge-Erinnerungen nutzen die Intervalle, die du oder deine Ärztin bzw. dein Arzt eingetragen habt. HealthLog liefert keinen eigenen Screening-Plan mit."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Preventive-care reminders use the intervals you or your doctor entered. HealthLog does not ship a screening schedule of its own."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "预防保健提醒使用的是你或你的医生录入的间隔。HealthLog 并不自带一份筛查日程。"
          }
        }
      }
    },
    "sources.caveat.esh-2023-hypertension": {
      "comment": "1.4.1 caveat",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Reine Hypertonie-Leitlinie; seit 2023 kein gemeinsames ESC-Dokument."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pure hypertension guideline; not a joint ESC document since 2023."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这是单纯的高血压指南；自 2023 年起，它不再是与 ESC 联合的文件。"
          }
        }
      }
    },
    "sources.caveat.steps-saint-maurice-2020": {
      "comment": "1.4.1 caveat",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "US-Erwachsenenkohorte, beobachtend; der Nutzen steigt bis etwa 12.000 Schritte/Tag weiter."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "US adult cohort, observational; benefit keeps accumulating through ~12,000 steps/day."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "美国成人队列，观察性的；益处会一直累积到每天约 12,000 步。"
          }
        }
      }
    },
    "sources.caveat.who-2020-physical-activity": {
      "comment": "1.4.1 caveat",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nennt Minuten pro Woche, kein Schrittziel."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Publishes minutes per week, not a step quota."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "公布的是每周分钟数，不是步数目标。"
          }
        }
      }
    },
    "sources.caveat.bts-2017-emergency-oxygen": {
      "comment": "1.4.1 caveat",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Klinischer Notfallkontext, kein Verbraucher-Monitoring."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hospital emergency context, not consumer monitoring."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "医院急诊场景，不是消费者监测。"
          }
        }
      }
    },
    "sources.caveat.nice-ng115-copd": {
      "comment": "1.4.1 caveat",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "COPD-bezogen; nur als „ärztlich abklären“-Untergrenze brauchbar."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "COPD-focused; useful only as the “call your provider” floor."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "以 COPD 为重点；只适合作为“联系你的医疗服务提供者”这一下限。"
          }
        }
      }
    },
    "sources.caveat.ada-2024-glycemic": {
      "comment": "1.4.1 caveat",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nüchtern 80 bis 130, nach Mahlzeiten < 180 mg/dL; kein publiziertes Erwachsenen-Ziel zur Schlafenszeit."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fasting 80 to 130, post-meal < 180 mg/dL; no published adult bedtime target."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "空腹 80 至 130，餐后 < 180 mg/dL；没有已发表的成人睡前目标。"
          }
        }
      }
    },
    "sources.caveat.ispad-2022-pediatric": {
      "comment": "1.4.1 caveat",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Pädiatrischer Typ-1-Kontext; nicht für Erwachsene validiert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Paediatric type-1 context; not validated for adults."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "儿科 1 型语境；未针对成人验证。"
          }
        }
      }
    },
    "sources.caveat.ace-body-fat-standards": {
      "comment": "1.4.1 caveat",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Referenzkategorien; klinische Entscheidungen nutzen DEXA oder Hydrodensitometrie."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reference categories; clinical decisions use DEXA or hydrostatic weighing."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "参考分类；临床决策使用 DEXA 或水下称重。"
          }
        }
      }
    },
    "sources.caveat.aasm-2015-adult-sleep": {
      "comment": "1.4.1 caveat",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ziel ≥ 7 h für Erwachsene; ältere Menschen brauchen ggf. etwas weniger."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Target ≥ 7 h for adults; older adults may need slightly less."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "成人的目标是 ≥ 7 小时；老年人可能需要略少一些。"
          }
        }
      }
    },
    "sources.caveat.watson-1980-tbw": {
      "comment": "1.4.1 caveat",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Anthropometrische Schätzung des Gesamtkörperwassers; Vorhersage, keine Messung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Anthropometric estimate of total body water; predictive, not a measurement."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "总体水的人体测量学估计；属于预测，不是测量。"
          }
        }
      }
    },
    "sources.caveat.icrp-89-reference-man": {
      "comment": "1.4.1 caveat",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Referenzwerte für einen idealisierten Erwachsenen; große individuelle Streuung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reference values for an idealised adult; individual variation is broad."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "针对一个理想化成人的参考值；个体差异很大。"
          }
        }
      }
    },
    "sources.caveat.aha-2024-rhr": {
      "comment": "1.4.1 caveat",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Allgemeines Erwachsenenband 60 bis 100; ein trainiertes Herz liegt oft bei 40 bis 60. Ein neuer Tiefwert mit Schwindel ist das Warnzeichen, nicht die Zahl."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "General adult band 60 to 100; a trained heart can sit at 40 to 60. A new low with dizziness is the concern, not the number."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一般成人区间为 60 至 100；经过训练的心脏可以处在 40 至 60。需要关注的是伴有头晕的新低值，而不是这个数字。"
          }
        }
      }
    },
    "sources.caveat.statpearls-pulse-ox": {
      "comment": "1.4.1 caveat",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gesundes Raumluft-Band; optische Verbraucher-SpO₂ ist auf ±2 bis 4 % genau, ein einzelner Tiefwert ist oft ein Artefakt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Healthy room-air band; consumer optical SpO₂ is accurate to ±2 to 4 %, a single low reading is often artefact."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "健康的室内空气区间；消费级光学 SpO₂ 的准确度为 ±2 至 4%，单次偏低读数常常是伪迹。"
          }
        }
      }
    },
    "sources.caveat.acc-aha-2017-bp": {
      "comment": "1.4.1 caveat",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "US-Leitlinie; stuft 130 bis 139/80 bis 89 als Stadium 1 ein. Das ist strenger als die ESH-Vorgabe und wird zum Vergleich gezeigt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "US guideline; labels 130 to 139/80 to 89 as stage 1. That is stricter than the ESH default and shown for comparison."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "美国指南；把 130 至 139/80 至 89 标为 1 期。这比 ESH 的默认更严，列在这里是为了对照。"
          }
        }
      }
    },
    "sources.caveat.esc-2024-bp": {
      "comment": "1.4.1 caveat",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Europäisch; ergänzt ein „erhöht“-Band 120 bis 139/70 bis 89 und ein Behandlungsziel von 120 bis 129. Kontext, nicht die verwendete Einteilung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "European; adds an “elevated” band of 120 to 139/70 to 89 and a treated target of 120 to 129. Context, not the shipped classification."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "欧洲的；增加一个 120 至 139/70 至 89 的“升高”带，以及 120 至 129 这一已治疗目标。这是背景，不是本产品所采用的分类。"
          }
        }
      }
    },
    "sources.caveat.statpearls-pulse-pressure": {
      "comment": "1.4.1 caveat",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Physiologische Lehrreferenz; der Pulsdruck ist ein Gesprächsanlass, nie eine Diagnose."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Educational physiology reference; pulse pressure is a discussion prompt, never a diagnosis."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "生理学教学参考；脉压是一个用来展开讨论的提示，绝不是诊断。"
          }
        }
      }
    },
    "sources.caveat.statpearls-map": {
      "comment": "1.4.1 caveat",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Untergrenze von etwa 60 mmHg ist ein Perfusionskonzept der Akutmedizin, kein Verbraucheralarm."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The ~60 mmHg floor is an acute-care perfusion concept, not a consumer alarm."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "约 60 mmHg 这一下限是急症护理中的灌注概念，不是面向消费者的警报。"
          }
        }
      }
    },
    "sources.caveat.esc-esh-2018-pwv": {
      "comment": "1.4.1 caveat",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "cf-PWV > 10 m/s ist die klinische Referenz; Gefäßalter-Schätzungen von Verbrauchergeräten sind Näherungen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "cf-PWV > 10 m/s is the clinical reference; consumer vascular-age estimates are proxies."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "cf-PWV > 10 m/s 是临床参考；消费级设备的血管年龄估计是代理值。"
          }
        }
      }
    },
    "sources.caveat.fda-2024-pulse-ox": {
      "comment": "1.4.1 caveat",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Belegt Überschätzung bei dunklerer Haut; ein einzelner fast-normaler Wert ist keine Entwarnung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Documents over-reading on darker skin; a single near-normal reading is not a clearance."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已有文献记载，在较深的肤色上会把读数读高；单次接近正常的读数并不是解除警报。"
          }
        }
      }
    },
    "sources.caveat.jgim-2019-temperature": {
      "comment": "1.4.1 caveat",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Oral-äquivalenter Mittelwert; Messorte weichen bis ~1 °C ab, also vor dem Vergleich den Messort beachten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Oral-equivalent mean; sites differ by up to ~1 °C, so note the measurement site before comparing."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "口温等效均值；测量部位之间最多可相差约 1 °C，所以比较之前请记下测量部位。"
          }
        }
      }
    },
    "sources.caveat.rcp-2017-news2": {
      "comment": "1.4.1 caveat",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Klinischer Verschlechterungs-Score; die Grenze ≥ 25/min ist klinischer Kontext, kein Selbstmonitoring-Alarm."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hospital deterioration score; the ≥ 25/min cut-off is clinical context, not a self-monitoring alarm."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "医院恶化评分；≥ 25/min 这一切点属于临床背景，不是自我监测警报。"
          }
        }
      }
    },
    "sources.caveat.ala-respiratory-rate": {
      "comment": "1.4.1 caveat",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Allgemeines Ruheband für Erwachsene; bei Kindern höher, verändert sich mit Aktivität, Fieber und Emotion."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "General adult resting band; rates run higher in children and shift with activity, fever and emotion."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一般成人的静息区间；儿童更高，并且会随活动、发热和情绪而变化。"
          }
        }
      }
    },
    "sources.caveat.vat-imaging-threshold": {
      "comment": "1.4.1 caveat",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bildgebungs-Grenzwerte in cm²; die „Viszeralfett-Stufe“ einer Waage ist eine eigene, einheitenlose Skala."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Imaging cm² thresholds; a scale's “visceral fat rating” is a separate unit-less scale."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "影像学的 cm² 阈值；体重秤的“内脏脂肪评级”是另一套没有单位的量表。"
          }
        }
      }
    },
    "sources.caveat.wilcox-2000-fertile-window": {
      "comment": "1.4.1 caveat",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Zeitpunkt des fruchtbaren Fensters schwankt stark; Kalenderschätzungen sind keine Verhütungsmethode."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fertile-window timing is highly variable; calendar estimates are not a contraceptive method."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "易孕窗口的时间高度可变；日历估计不是避孕方法。"
          }
        }
      }
    },
    "sources.caveat.acog-co651-2015": {
      "comment": "1.4.1 caveat",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zyklus als Vitalzeichen; genaue Abklärungsgrenzen bitte an der aktuellen ACOG-Guidance prüfen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cycle as a vital sign; exact consultation thresholds should be confirmed against the live ACOG guidance."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把生理周期当作一项生命体征；确切的就诊阈值，应对照现行的 ACOG 指引加以确认。"
          }
        }
      }
    },
    "sources.caveat.phillips-2017-sri": {
      "comment": "1.4.1 caveat",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Konstrukt der Schlafregelmäßigkeit; keine universelle Gut/Schlecht-Grenze. Als persönlichen Trend lesen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sleep-regularity construct; no universal good/bad threshold. Read it as a personal trend."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "睡眠规律性这一构念；没有通用的好与坏的阈值。请把它当作个人趋势来看。"
          }
        }
      }
    },
    "sources.caveat.cdc-2024-sleep": {
      "comment": "1.4.1 caveat",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Allgemeine Schlafhygiene-Empfehlungen; der Bedarf ist individuell."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "General sleep-hygiene guidance; individual needs vary."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一般睡眠卫生指导；个体需求各不相同。"
          }
        }
      }
    },
    "sources.caveat.who-2000-bmi": {
      "comment": "1.4.1 caveat",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bevölkerungs-Screening, keine Diagnose; in asiatischen Bevölkerungen steigt das Risiko bei niedrigeren Grenzen, und der BMI unterscheidet nicht Muskel von Fett."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Population screen, not a diagnosis; Asian-population risk rises at lower cut-offs and BMI does not distinguish muscle from fat."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "人群筛查，不是诊断；亚洲人群的风险在更低的切点就会升高，而且 BMI 不区分肌肉和脂肪。"
          }
        }
      }
    },
    "sources.caveat.who-idf-2006-glucose": {
      "comment": "1.4.1 caveat",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Setzt die Grenze für gestörte Nüchternglukose bei 110 mg/dL; die Diabetes-Grenze (≥ 126) ist mit der ADA identisch."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sets the impaired-fasting-glucose floor at 110 mg/dL; the diabetes threshold (≥ 126) is shared with ADA."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把空腹血糖受损的下限定在 110 mg/dL；糖尿病阈值（≥ 126）与 ADA 相同。"
          }
        }
      }
    },
    "sources.caveat.esc-naspe-1996-hrv": {
      "comment": "1.4.1 caveat",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Klinische 24-Stunden-SDNN-Normen sind nicht mit nächtlichem Wearable-RMSSD austauschbar; nur der persönliche Trend ist aussagekräftig."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Clinical 24-hour SDNN norms are not interchangeable with an overnight wearable RMSSD; only the personal trend is meaningful."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "临床 24 小时 SDNN 常模不能与夜间可穿戴设备的 RMSSD 互换；只有个人趋势有意义。"
          }
        }
      }
    },
    "sources.caveat.benjamini-hochberg-1995": {
      "comment": "1.4.1 caveat",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontrolliert den erwarteten Anteil falscher Entdeckungen unter den gezeigten Paaren; macht kein einzelnes Paar sicher."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Controls the expected share of false discoveries among the shown pairs; it does not make any single pair certain."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "它控制所示配对之中错误发现的预期比例；它并不能使任何一个单独的配对成为定论。"
          }
        }
      }
    },
    "sources.caveat.esc-eas-2019-dyslipidaemia": {
      "comment": "1.4.1 caveat",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "LDL-Ziele hängen vom individuellen Herz-Kreislauf-Risiko ab; das vorausgefüllte ≤ 116 mg/dL ist das Ziel bei niedrigem Risiko."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "LDL goals depend on individual cardiovascular risk; the pre-filled ≤ 116 mg/dL is the low-risk goal."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "LDL 目标取决于个人的心血管风险；预填的 ≤ 116 mg/dL 是低风险目标。"
          }
        }
      }
    },
    "sources.caveat.eas-2022-lpa": {
      "comment": "1.4.1 caveat",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lp(a) ist weitgehend genetisch; die Linie bei 125 nmol/L markiert erhöhtes Risiko, keine Behandlungsschwelle."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lp(a) is largely genetic; the 125 nmol/L line marks increased risk, not a treatment threshold."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Lp(a) 在很大程度上是遗传决定的；125 nmol/L 这条线标志风险升高，不是治疗阈值。"
          }
        }
      }
    },
    "sources.caveat.kdigo-2012-ckd": {
      "comment": "1.4.1 caveat",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "eGFR-Kategorien brauchen Persistenz über drei Monate und Kontext; ein Einzelwert ist keine Diagnose."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "eGFR categories need persistence over three months and context; a single value is not a diagnosis."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "eGFR 分类需要持续三个月，并且需要结合具体情况；单个数值不是诊断。"
          }
        }
      }
    },
    "sources.caveat.matthews-1985-homa-ir": {
      "comment": "1.4.1 caveat",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Modellschätzung aus Nüchternglukose und -insulin; assayabhängig, keine universelle Grenze."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A model estimate from fasting glucose and insulin; assay-dependent, no universal cut-off."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "由空腹血糖和胰岛素得出的模型估计；随检测方法而变，没有通用切点。"
          }
        }
      }
    },
    "sources.caveat.harris-2004-omega3-index": {
      "comment": "1.4.1 caveat",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vorgeschlagene Risikozonen (< 4 %, 4 bis 8 %, > 8 %) aus Kohortendaten; kein Behandlungsziel."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Proposed risk zones (< 4 %, 4 to 8 %, > 8 %) from cohort data; not a treatment target."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "来自队列数据的拟议风险区间（< 4%，4 至 8%，> 8%）；不是治疗目标。"
          }
        }
      }
    },
    "sources.caveat.kroenke-2001-phq9": {
      "comment": "1.4.1 caveat",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Screening-Instrument; die Schwerebänder 5/10/15/20 unterstützen ein klinisches Gespräch, ersetzen es nicht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Screening instrument; severity bands 5/10/15/20 support, but do not replace, a clinical interview."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "筛查工具；严重程度档 5/10/15/20 可以支持临床访谈，但不能取代临床访谈。"
          }
        }
      }
    },
    "sources.caveat.spitzer-2006-gad7": {
      "comment": "1.4.1 caveat",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Screening-Instrument; die Bänder 5/10/15 zeigen leichte/mittlere/schwere Symptome an, keine Diagnose."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Screening instrument; bands 5/10/15 indicate mild/moderate/severe symptoms, not a diagnosis."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "筛查工具；5/10/15 这几档表示轻度、中度、重度症状，不是诊断。"
          }
        }
      }
    },
    "sources.caveat.topp-2015-who5": {
      "comment": "1.4.1 caveat",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Wert ≤ 50 deutet auf niedriges Wohlbefinden hin, das einen genaueren Blick lohnt; keine Depressionsdiagnose."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A score ≤ 50 suggests low wellbeing worth a closer look; it is not a depression diagnosis."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "评分 ≤ 50 提示身心安适偏低，值得再仔细看一看；这不是抑郁诊断。"
          }
        }
      }
    },
    "sources.caveat.espie-2014-sci": {
      "comment": "1.4.1 caveat",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In einer Online-Stichprobe validiert; ≤ 16 war mit wahrscheinlicher Insomnie assoziiert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Validated in an online sample; ≤ 16 was associated with probable insomnia disorder."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在一个在线样本中得到验证；≤ 16 与可能的失眠障碍相关。"
          }
        }
      }
    },
    "sources.caveat.roenneberg-2003-mctq": {
      "comment": "1.4.1 caveat",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fragebogen-basierter Chronotyp; HealthLog wendet dieselbe Schlafmitte-Formel auf erfassten Schlaf an."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Questionnaire-derived chronotype; HealthLog applies the same mid-sleep formula to tracked sleep."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "由问卷得到的时型；HealthLog 对所跟踪的睡眠使用同一个睡眠中点公式。"
          }
        }
      }
    },
    "sources.caveat.wittmann-2006-social-jetlag": {
      "comment": "1.4.1 caveat",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Definiert sozialen Jetlag als Differenz der Schlafmitte zwischen Arbeits- und freien Tagen; Zusammenhänge, keine Ursachen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Defines social jetlag as the workday/free-day mid-sleep difference; associations, not causes."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把社交时差定义为工作日与自由日睡眠中点之差；这是关联，不是原因。"
          }
        }
      }
    },
    "sources.caveat.tudor-locke-2011-steps": {
      "comment": "1.4.1 caveat",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erwachsenen-Schrittkategorien aus Pedometer-Studien; nur Orientierung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Adult step-count categories from pedometer studies; orientation only."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "来自计步研究的成人步数分类；仅供定向。"
          }
        }
      }
    },
    "sources.caveat.hirshkowitz-2015-nsf-sleep": {
      "comment": "1.4.1 caveat",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Expertenkonsens: 7 bis 9 h empfohlen für Erwachsene von 18 bis 64, 7 bis 8 h ab 65."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Expert consensus: 7 to 9 h recommended for adults aged 18 to 64, 7 to 8 h for 65+."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "专家共识：建议 18 至 64 岁的成人睡 7 至 9 小时，65 岁及以上睡 7 至 8 小时。"
          }
        }
      }
    },
    "sources.caveat.cdc-nhanes": {
      "comment": "1.4.1 caveat",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "US-Bevölkerungserhebung; Mittelwerte und Streuungen sind keine persönlichen Ziele."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "US population survey data; means and spreads are not personal targets."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "美国人群调查数据；均值和离散程度不是个人目标。"
          }
        }
      }
    },
    "sources.caveat.efsa-drv": {
      "comment": "1.4.1 caveat",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Referenzwerte für gesunde europäische Erwachsene; der Bedarf weicht in Schwangerschaft, Krankheit und unter Medikation ab."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reference values for healthy European adults; needs differ in pregnancy, illness and with medication."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "健康欧洲成人的参考值；在妊娠、疾病以及用药时，需求并不相同。"
          }
        }
      }
    },
    "sources.caveat.who-2020-ferritin": {
      "comment": "1.4.1 caveat",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ferritin-Grenzen verschieben sich bei Entzündung; zusammen mit CRP und Transferrinsättigung deuten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ferritin thresholds shift with inflammation; interpret with CRP and transferrin saturation."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "铁蛋白阈值会随炎症而移动；请结合 CRP 和转铁蛋白饱和度来解读。"
          }
        }
      }
    },
    "sources.caveat.holick-2011-vitamin-d": {
      "comment": "1.4.1 caveat",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Definiert ausreichende Versorgung ab ≥ 30 ng/mL; andere Gremien setzen 20 ng/mL. Die Bereiche unterscheiden sich tatsächlich."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Defines sufficiency at ≥ 30 ng/mL; other bodies set 20 ng/mL. The ranges genuinely differ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把充足定为 ≥ 30 ng/mL；其他机构定为 20 ng/mL。这些范围确实并不相同。"
          }
        }
      }
    },
    "sources.caveat.jonklaas-2014-ata-thyroid": {
      "comment": "1.4.1 caveat",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "TSH-Referenzintervalle sind labor- und altersabhängig; 0,4 bis 4 mIU/L ist ein gängiges Erwachsenenfenster."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "TSH reference intervals are lab- and age-dependent; 0.4 to 4 mIU/L is a common adult window."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "TSH 的参考区间取决于检验机构和年龄；0.4 至 4 mIU/L 是一个常见的成人窗口。"
          }
        }
      }
    },
    "sources.caveat.pearson-2003-crp": {
      "comment": "1.4.1 caveat",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "hs-CRP < 1 niedrig, 1 bis 3 durchschnittlich, > 3 mg/L höheres Herz-Kreislauf-Risiko (nur außerhalb akuter Infekte)."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "hs-CRP < 1 low, 1 to 3 average, > 3 mg/L higher cardiovascular risk (only outside acute infection)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "hs-CRP < 1 为低，1 至 3 为平均，> 3 mg/L 为较高的心血管风险（仅在急性感染之外）。"
          }
        }
      }
    },
    "sources.caveat.who-2024-haemoglobin": {
      "comment": "1.4.1 caveat",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Anämie-Grenzen nach Geschlecht, Alter und Schwangerschaft; Anpassungen für Höhe und Rauchen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Anaemia cut-offs by sex, age and pregnancy; altitude and smoking adjustments apply."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "贫血切点按性别、年龄和妊娠划分；适用海拔和吸烟方面的调整。"
          }
        }
      }
    },
    "sources.caveat.frid-2016-injection-technique": {
      "comment": "1.4.1 caveat",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Insulin-bezogene Empfehlungen; die Stellenrotation gilt für alle subkutanen Injektionen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Insulin-focused recommendations; site rotation applies to all subcutaneous injections."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "以胰岛素为重点的建议；部位轮换适用于所有皮下注射。"
          }
        }
      }
    },
    "sources.caveat.nes-2011-fitness-age": {
      "comment": "1.4.1 caveat",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "VO₂peak-Modell ohne Belastungstest aus einer norwegischen Kohorte; eine Wearable-VO₂max-Schätzung addiert eigenen Fehler."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Non-exercise VO₂peak model from a Norwegian cohort; a wearable VO₂max estimate adds its own error."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "来自一个挪威队列的非运动 VO₂peak 模型；可穿戴设备的 VO₂max 估计会再加上它自己的误差。"
          }
        }
      }
    },
    "sources.caveat.who-2011-waist": {
      "comment": "1.4.1 caveat",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Taillengrenzen unterscheiden sich nach Geschlecht und Bevölkerung; das Maßband braucht eine konstante Position."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Waist cut-offs differ by sex and population; a tape measure needs consistent placement."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "腰围切点因性别和人群而不同；软尺的放置位置需要保持一致。"
          }
        }
      }
    },
    "sources.caveat.leong-2015-grip": {
      "comment": "1.4.1 caveat",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Griffkraft sagt auf Bevölkerungsebene Verläufe voraus; Gerät und Haltung verändern die Zahl."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Grip strength predicts outcomes at population level; device and posture change the number."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "握力在人群层面预测结局；设备和姿势会改变这个数字。"
          }
        }
      }
    },
    "sources.caveat.ats-2002-six-minute-walk": {
      "comment": "1.4.1 caveat",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Klinikprotokoll auf ebener 30-m-Strecke; eine Telefon-Schätzung ist nicht der standardisierte Test."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Clinic protocol on a flat 30 m course; a phone estimate is not the standardised test."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在平坦的 30 米路线上实施的临床方案；手机的估计并不是那项标准化测试。"
          }
        }
      }
    },
    "sources.caveat.who-2018-noise": {
      "comment": "1.4.1 caveat",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gesundheitsleitlinie zu Umgebungslärm; die Expositionsschätzung des Telefons ist nur ein Anhaltspunkt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Environmental-noise health guidance; a phone's exposure estimate is indicative only."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关于环境噪声的健康指引；手机的暴露估计只是一个示意。"
          }
        }
      }
    },
    "sources.caveat.apple-ecg": {
      "comment": "1.4.1 caveat",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die EKG-App ordnet nur den Rhythmus ein; sie erkennt keinen Herzinfarkt und keine Gerinnsel."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The ECG app classifies rhythm only; it cannot detect a heart attack or clots."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "ECG 应用只对节律进行分类；它不能检测心脏病发作，也不能检测血栓。"
          }
        }
      }
    },
    "sources.caveat.apple-irregular-rhythm": {
      "comment": "1.4.1 caveat",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hinweise sind gelegentliche Hintergrundprüfungen, kein Dauermonitoring."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Notifications are occasional background checks, not continuous monitoring."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通知是偶尔进行的后台检查，不是持续监测。"
          }
        }
      }
    },
    "sources.caveat.apple-walking-steadiness": {
      "comment": "1.4.1 caveat",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aus iPhone-Bewegungsdaten beim Tragen geschätzt; keine klinische Ganganalyse."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Estimated from iPhone motion data while carried; not a clinical gait analysis."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "根据携带状态下的 iPhone 运动数据估算；不是临床步态分析。"
          }
        }
      }
    },
    "sources.caveat.apple-sleep-apnea": {
      "comment": "1.4.1 caveat",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erkennt Anzeichen mittlerer bis schwerer Schlafapnoe über 30 Nächte; schließt Apnoe nicht aus."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Flags signs of moderate-to-severe sleep apnea over 30 nights; it does not rule apnea out."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "标出 30 个夜晚里中度至重度睡眠呼吸暂停的迹象；它不能排除呼吸暂停。"
          }
        }
      }
    },
    "sources.caveat.studenski-2011-gait-speed": {
      "comment": "1.4.1 caveat",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gepoolte Kohortenanalyse bei älteren Erwachsenen; Gehgeschwindigkeit ist ein Bevölkerungsmarker, kein individuelles Urteil."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pooled cohort analysis in older adults; gait speed is a population marker, not an individual verdict."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "针对老年人的合并队列分析；步速是一个人群标志，不是对个人的判定。"
          }
        }
      }
    },
    "sources.caveat.abim-2026-lab-reference-ranges": {
      "comment": "1.4.1 caveat",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Referenzblatt für Ärztinnen und Ärzte (Erwachsenen-Intervalle); das gedruckte Intervall deines Labors gilt immer."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reference sheet for physicians (adult intervals); your laboratory's printed interval always wins."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "供医生使用的参考表（成人区间）；始终以你的实验室印出的区间为准。"
          }
        }
      }
    },
    "insights.digest.bmi.guideline.who2000": {
