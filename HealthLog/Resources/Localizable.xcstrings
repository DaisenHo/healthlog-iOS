    "sessions.signOutAll.else.footer": {
      "comment": "Sessions screen — footer under the sign-out-everywhere button on servers from v1.38.11, where this device is spared.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Meldet alle Browser-Sitzungen ab und widerruft die Anmeldung aller anderen Apps. Dieses Gerät bleibt angemeldet. Nutze das, wenn du ein Gerät verloren hast."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Signs out every browser session and revokes every other app sign-in. This device stays signed in. Use this if you have lost a device."
          }
        }
      }
    },
    "sessions.signOutAll.footer": {
