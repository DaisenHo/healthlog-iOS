    "devices.dualwrite.footnote": {
      "comment": "v0.6.0.7 P4 — Footnote below the paired-devices card explaining that BLE-cuff readings are written both to the HealthLog server and back into Apple Health (DeviceReadingForwarder dual-write contract).",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verbundene Messungen werden sowohl im Server gespeichert als auch in Apple Health geschrieben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connected device readings are written both to the server and to Apple Health."
          }
        }
      }
    },
