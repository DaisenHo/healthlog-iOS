    "mood.tags.manage.purge.body": {
      "comment": "Parity 1.1/1.7/1.8 — Phase 1 Datenintegritaet.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Tag wird aus %lld bisherigen Einträgen entfernt. Das lässt sich nicht rückgängig machen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This removes the tag from %lld past entries. This cannot be undone."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这将从 %lld 条过往记录中移除该标签。此操作无法撤销。"
          }
        }
      }
    },
