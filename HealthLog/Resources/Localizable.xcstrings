    "settings.hkdiag.server_footer": {
      "comment": "CU-21 — explains absence semantics + the multi-day device check.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aufgeführt sind nur Typen, von denen der Server schon einmal etwas gesehen hat. Ein fehlender Typ hat noch nie geliefert, er steht nicht auf null. Trage das iPhone zwei bis drei Tage normal: Zeigt der letzte Auslöser dann „Hintergrund“ oder „Push“, liefert dieses Gerät auch ohne geöffnete App."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only types the server has already seen appear here. A missing type has never delivered, it is not at zero. Carry the iPhone normally for two to three days: once the last trigger reads “Background” or “Push”, this device delivers without the app being open."
          }
        }
      }
    },
    "settings.hkdiag.server_last_background": {
      "comment": "CU-21 — row label for the last background sync timestamp.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Letzter Hintergrund-Sync"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Last background sync"
          }
        }
      }
    },
    "settings.hkdiag.server_no_data": {
      "comment": "CU-21 — server answered but reports nothing about sync health yet.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Server meldet zu dieser Verbindung noch keine Sync-Gesundheit."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The server does not report sync health for this connection yet."
          }
        }
      }
