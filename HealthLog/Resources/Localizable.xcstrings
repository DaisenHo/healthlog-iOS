    "biomarker.editor.seed.footer": {
      "comment": "Biomarker editor — the seed pre-fills editable defaults, not fixed truth.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Füllt Name, Einheit und Referenzbereich vor. Alles bleibt änderbar, denn Referenzbereiche unterscheiden sich je nach Labor, Geschlecht und Alter."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pre-fills name, unit and reference range. Everything stays editable, because reference ranges differ by lab, sex and age."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "预填名称、单位和参考范围。一切仍可编辑，因为参考范围会因检验机构、性别和年龄而不同。"
          }
        }
      }
    },
    "biomarker.editor.seed.label": {
      "comment": "Biomarker editor — seed catalog picker label.",
      "extractionState": "manual",
      "localizations": {
