    "insights.overview.description": {
      "comment": "Insights overview — static intro line under the header (mirrors web Insights overview).",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein metrik-übergreifender Blick auf deine Gesundheit: das heutige Briefing, wie deine Werte zusammenhängen und die Trends, die sich lohnen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
