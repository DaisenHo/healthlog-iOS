    "reminders.create.type.footer": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle einen Messwert, damit sich die Erinnerung automatisch erledigt, sobald ein passender Wert eintrifft. Ohne Messwert markierst du sie manuell als erledigt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pick a measurement type so the reminder auto-resolves when a matching reading arrives. Without one, you mark it done manually."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择测量类型后，收到匹配读数时提醒会自动完成。未关联类型时需手动标记完成。"
          }
        }
      }
    },
