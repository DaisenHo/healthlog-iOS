    "feature_disabled.subtitle": {
      "comment": "F-1 — neutral placeholder subtitle when a server-AI / on-device surface is disabled via /api/feature-flags. Operator-control philosophy: never blame the user, never expose the surface key.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Operator hat sie ausgeschaltet."
          }
