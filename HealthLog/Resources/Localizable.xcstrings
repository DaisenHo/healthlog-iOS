    "stepUp.record.required": {
      "comment": "Shown on a record action (share link, token, backup) when the server asks for a fresh proof",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitte bestätige, dass du es bist, um fortzufahren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Please confirm it's you to continue."
          }
        }
      }
    },
    "stepUp.record.body": {
      "comment": "Body of the step-up sheet in front of a record action",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Damit gibst du deine Gesundheitsdaten oder einen dauerhaften Zugang dazu weiter. Bestätige, dass du es bist, dann geht es weiter."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This hands your health record, or lasting access to it, to someone. Confirm it's you, then it continues."
          }
        }
      }
    },
    "sessions.signOutAll.keepShareLinks": {
      "comment": "Toggle on the sessions screen: sign out everywhere but keep clinician share links (keepShareLinks=1)",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Arzt-Links behalten"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep doctor share links"
          }
        }
      }
    },
    "sessions.signOutAll.everything.confirmBody": {
      "comment": "Sign out everywhere confirmation, server >= 1.39.3",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle Browser-Sitzungen und alle anderen App-Anmeldungen werden beendet. Auch verbundene KI-Assistenten, API-Tokens und Arzt-Links funktionieren danach nicht mehr. Dieses Gerät bleibt angemeldet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every browser session and every other app sign-in ends. Connected AI assistants, API tokens and doctor share links stop working too. This device stays signed in."
          }
        }
      }
    },
    "sessions.signOutAll.everything.keepLinks.confirmBody": {
      "comment": "Sign out everywhere confirmation with share links kept, server >= 1.39.3",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle Browser-Sitzungen und alle anderen App-Anmeldungen werden beendet. Auch verbundene KI-Assistenten und API-Tokens funktionieren danach nicht mehr. Deine Arzt-Links bleiben aktiv. Dieses Gerät bleibt angemeldet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every browser session and every other app sign-in ends. Connected AI assistants and API tokens stop working too. Your doctor share links stay active. This device stays signed in."
          }
        }
      }
    },
    "sessions.signOutAll.everything.footer": {
      "comment": "Sign out everywhere footer, server >= 1.39.3",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Meldet alle Browser-Sitzungen und alle anderen Apps ab und beendet verbundene KI-Assistenten, API-Tokens und Arzt-Links. Dieses Gerät bleibt angemeldet. Nutze das, wenn du ein Gerät verloren hast."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Signs out every browser session and every other app, and ends connected AI assistants, API tokens and doctor share links. This device stays signed in. Use this if you have lost a device."
          }
        }
      }
    },
    "sessions.signOutAll.everything.doneBody": {
      "comment": "Sign out everywhere done, server >= 1.39.3",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Andere Sitzungen und App-Anmeldungen wurden beendet, ebenso verbundene KI-Assistenten, API-Tokens und Arzt-Links. Dieses Gerät bleibt angemeldet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Other sessions and app sign-ins have ended, and so have connected AI assistants, API tokens and doctor share links. This device stays signed in."
          }
        }
      }
    },
    "sessions.signOutAll.everything.keepLinks.doneBody": {
      "comment": "Sign out everywhere done with share links kept, server >= 1.39.3",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Andere Sitzungen und App-Anmeldungen wurden beendet, ebenso verbundene KI-Assistenten und API-Tokens. Deine Arzt-Links sind weiter aktiv. Dieses Gerät bleibt angemeldet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Other sessions and app sign-ins have ended, and so have connected AI assistants and API tokens. Your doctor share links are still active. This device stays signed in."
          }
        }
      }
    },
    "sessions.signOutAll.grantsKept %@": {
      "comment": "After sign out everywhere: accepted access grants the server kept (grantsKept); %@ is a list of names",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Weiterhin Einblick in deine Daten haben, weil du ihnen Zugriff gegeben hast: %@. Den Zugriff kannst du im Web beenden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Still able to see your data, because you gave them access: %@. You can end their access on the web."
          }
        }
      }
    },
