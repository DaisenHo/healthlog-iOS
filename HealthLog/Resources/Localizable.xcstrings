    "report.selection.noVocabulary": {
      "comment": "CU-11 — report-selection panel (POST /api/export/health-record, selection v2).",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Server hat keine Auswahlliste geliefert. Ohne sie gibt es nichts, was wir ehrlich anbieten könnten, und eine eigene Liste raten wir bewusst nicht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your server served no selection list. Without it there is nothing we could honestly offer, and we deliberately do not invent one."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的服务器没有提供选择列表。没有它，我们就没有任何可以诚实提供的内容，而且我们有意不编造一份。"
          }
        }
      }
    },
    "report.selection.notice.dropped": {
      "comment": "CU-11 — report-selection panel (POST /api/export/health-record, selection v2).",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%d gespeicherte Einträge gibt es auf diesem Server nicht mehr und wurden entfernt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%d saved entries no longer exist on this server and were removed."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "有 %d 条已保存的记录在此服务器上已不存在，因而被移除。"
          }
        }
      }
    },
    "report.selection.notice.rebuilt": {
      "comment": "CU-11 — report-selection panel (POST /api/export/health-record, selection v2).",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Auswahl enthielt Einträge, die dieser Server nicht kennt. Sie wurde aus der aktuellen Serverliste neu aufgebaut. Bitte prüfe sie und versuche es erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your selection contained entries this server does not know. It was rebuilt from the current server list. Please check it and try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的选择里含有这个服务器不认识的记录。它已根据当前的服务器列表重新构建。请检查后再试一次。"
          }
        }
      }
    },
