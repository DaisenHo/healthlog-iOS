    "insights.suggestedPrompts.weightVsPulse": {
      "comment": "Insights — suggested-prompts chip strip (mirrors web insights.suggestedPrompts).",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wie hat sich die Gewichtsabnahme auf meinen Puls ausgewirkt?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How did weight loss affect my pulse?"
          }
        },
        "zh-Hans": {
