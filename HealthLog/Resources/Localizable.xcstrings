          }
        }
      }
    },
    "insights.ecg.disclaimer": {
      "comment": "P8 parity — Insights ECG surface (copy contract, verbatim from the web catalogue insights.ecg.*) — PERMANENT, non-dismissible — REGULATORY: the recording DEVICE's own result, never a HealthLog verdict. Do NOT soften.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dies ist das Ergebnis, das dein Aufzeichnungsgerät erstellt hat. HealthLog liest oder interpretiert EKG-Aufzeichnungen nicht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This is the result your recording device produced. HealthLog does not read or interpret ECG recordings."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这是你的记录设备所产生的结果。HealthLog 不读取 ECG 记录，也不解读 ECG 记录。"
          }
        }
      }
    },
    "insights.ecg.empty.body": {
      "comment": "CU-37 — Insights ECG empty state: honest ‘nothing uploaded yet’ + the archive-import path that works today.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hier steht nichts, weil bisher keine EKG-Aufzeichnung zu HealthLog gelangt ist, nicht, weil keine existiert. HealthLog holt EKGs derzeit nicht von selbst aus Apple Health."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing here yet because no ECG recording has reached HealthLog, not because none exists. HealthLog does not currently fetch ECGs from Apple Health on its own."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这里还没有内容，是因为还没有任何 ECG 记录到达 HealthLog，并不是因为不存在这样的记录。HealthLog 目前不会自行从 Apple Health 获取 ECG。"
          }
        }
      }
    },
    "insights.ecg.empty.cta": {
      "comment": "CU-37 — Insights ECG empty state: honest ‘nothing uploaded yet’ + the archive-import path that works today.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zum Apple-Health-Import"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Go to Apple Health import"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "前往 Apple Health 导入"
          }
        }
      }
    },
    "insights.ecg.empty.hardwareNote": {
      "comment": "CU-37 — Insights ECG empty state: honest ‘nothing uploaded yet’ + the archive-import path that works today.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aufzeichnen kann ein EKG nur ein Gerät mit EKG-Funktion, etwa eine Apple Watch ab Series 4. Ohne so ein Gerät bleibt diese Fläche leer. Das ist kein Fehler."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only a device with an ECG feature can record one, for instance an Apple Watch Series 4 or later. Without such a device this surface simply stays empty; that is not an error."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只有具备 ECG 功能的设备才能记录一份 ECG，例如 Apple Watch Series 4 或更新的型号。没有这样的设备时，这个界面就会保持空白；这不是错误。"
          }
        }
      }
    },
    "insights.ecg.empty.pathStep1": {
      "comment": "CU-37 — Insights ECG empty state: honest ‘nothing uploaded yet’ + the archive-import path that works today.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In der Apple-Health-App dein vollständiges Archiv exportieren (export.zip)."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In the Apple Health app, export your full archive (export.zip)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 Apple Health 应用中，导出你的完整归档（export.zip）。"
          }
        }
      }
    },
    "insights.ecg.empty.pathStep2": {
      "comment": "CU-37 — Insights ECG empty state: honest ‘nothing uploaded yet’ + the archive-import path that works today.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Archiv in HealthLog unter Einstellungen > Integrationen > Apple-Health-Import hochladen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Upload that archive in HealthLog under Settings > Integrations > Apple Health import."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 HealthLog 的设置 > 集成 > Apple Health 导入中上传该归档。"
          }
        }
      }
    },
    "insights.ecg.empty.pathStep3": {
      "comment": "CU-37 — Insights ECG empty state: honest ‘nothing uploaded yet’ + the archive-import path that works today.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "HealthLog liest die EKG-Dateien aus dem Archiv. Was davon angekommen ist, steht direkt im Import-Status."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "HealthLog reads the ECG files out of the archive. What arrived is shown right in the import status."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "HealthLog 会从归档中读出 ECG 文件。已经到达的内容会直接显示在导入状态里。"
          }
        }
      }
    },
