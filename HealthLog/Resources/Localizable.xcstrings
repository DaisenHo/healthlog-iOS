    "settings.hkdiag.stats.title": {
      "comment": "V1 — Sync Diagnostics card title: when the summed and averaged types (day totals, pulse buckets) last reached the server.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tageswerte und Puls"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Day totals and pulse"
          }
        }
      }
    },
    "settings.hkdiag.stats.footer": {
      "comment": "V1 — Sync Diagnostics footer for the day totals card. Explains the trigger words.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was dieses iPhone als Tageswert oder 10-Minuten-Puls gesendet hat. Eine Prüfung ohne Änderung sendet nichts, deshalb kann der letzte neue Wert älter sein als die letzte Prüfung. Die Zeile „Server“ ist, was dein Server für denselben Typ empfangen hat, auch wenn der Wert als Einzelmessung kam. Hintergrund heißt, iOS hat die App geweckt, Vordergrund heißt, die App war offen, Manuell heißt, du hast auf „Jetzt syncen“ getippt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What this iPhone sent as a day total or 10-minute pulse. A check that finds no change sends nothing, so the last new value can be older than the last check. The “Server” line is what your server received for the same type, even when the value came as single readings. Background means iOS woke the app, Foreground means the app was open, Manual means you tapped “Sync now”."
          }
        }
      }
    },
    "settings.hkdiag.stats.last_sweep": {
      "comment": "V1 — Sync Diagnostics row: the last daily-totals check, with time and trigger.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zuletzt geprüft"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Last checked"
          }
        }
      }
    },
