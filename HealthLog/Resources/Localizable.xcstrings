    "insights.suggestedPrompts.weekVsMonth": {
      "comment": "Insights — suggested-prompts chip strip (mirrors web insights.suggestedPrompts).",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
