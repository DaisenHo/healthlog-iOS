    "cycle.learning.body": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erfasse deine Periode und Symptome über ein paar Zyklen, dann zeigt dir HealthLog deine Phasen und sagt voraus, was bevorsteht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Log your period and any symptoms over a few cycles, and HealthLog will start showing your phases and predicting what's ahead."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用几个生理周期记录你的经期和任何症状，HealthLog 就会开始显示你的阶段，并预测接下来的情况。"
          }
        }
      }
    },
