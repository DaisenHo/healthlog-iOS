    "settings.applehealth.ecgSync.footer": {
      "comment": "GH #74 — UI-Standard R2 (Folge): was das Einschalten bewirkt, sonst nichts.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Neue EKG-Aufzeichnungen samt Kurve gehen an deinen Server. HealthLog liest die Kurve nicht."
          }
        },
        "en": {
