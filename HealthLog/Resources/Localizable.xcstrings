    "mentalHealth.instrumentDescription.gad7": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Angst-Screening mit 7 Fragen. Beziehe dich auf die letzten zwei Wochen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "7-question anxiety screen. Answer for the last two weeks."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "7 题焦虑筛查。请根据过去两周的情况回答。"
          }
        }
      }
    },
    "mentalHealth.instrumentDescription.phq9": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Depressions-Screening mit 9 Fragen. Beziehe dich auf die letzten zwei Wochen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "9-question depression screen. Answer for the last two weeks."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "9 题抑郁筛查。请根据过去两周的情况回答。"
          }
        }
      }
    },
    "mentalHealth.instrumentDescription.sci": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schlaf-Check mit 8 Fragen. Die meisten Fragen beziehen sich auf den letzten Monat; höhere Werte bedeuten besseren Schlaf."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "8-question sleep check. Most questions ask about the past month; higher scores mean better sleep."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "8 题睡眠自评。大多数题目询问过去一个月；分数越高表示睡眠越好。"
          }
        }
      }
    },
    "mentalHealth.instrumentDescription.who5": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wohlbefindens-Check mit 5 Fragen. Beziehe dich auf die letzten zwei Wochen; höhere Werte bedeuten besseres Wohlbefinden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "5-question well-being check. Answer for the last two weeks; higher numbers mean better well-being."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "5 题幸福感自评。请根据过去两周的情况回答；分数越高表示幸福感越好。"
          }
        }
      }
    },
    "mentalHealth.instrumentSub.gad7": {
      "extractionState": "manual",
      "localizations": {
