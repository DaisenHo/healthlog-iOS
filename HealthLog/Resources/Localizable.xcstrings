    "HealthLog has no access to your Apple Health data on this device. Connect it so your values arrive automatically.": {
      "comment": "25-01 update-notice card (decision E-2026-08-28)",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "HealthLog hat auf diesem Gerät keinen Zugriff auf deine Apple-Health-Daten. Verbinde es, damit deine Werte automatisch eintreffen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "HealthLog has no access to your Apple Health data on this device. Connect it so your values arrive automatically."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "HealthLog 在这台设备上无法访问你的 Apple Health 数据。请连接它，这样你的数值就会自动到达。"
          }
        }
      }
    },
