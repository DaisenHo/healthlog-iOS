    "illness.optIn.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep a private journal of illnesses, injuries and ongoing conditions. You turned it off, but you can turn it back on here whenever you like."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Führe ein privates Tagebuch über Erkrankungen, Verletzungen und anhaltende Beschwerden. Du hast es ausgeschaltet, kannst es hier aber jederzeit wieder einschalten."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保留一份关于疾病、受伤和持续状况的私人日记。你已经把它关掉了，但可以随时在这里重新打开。"
          }
        }
      }
    },
    "illness.optIn.bullet.correlation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "See how your own vitals shifted around an illness, computed on the server from your baseline."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sieh, wie sich deine Vitalwerte rund um eine Erkrankung verändert haben, auf dem Server aus deiner Baseline berechnet."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "看看你自己的生命体征在一次疾病前后如何变化，由服务器根据你的个人基线计算。"
          }
        }
      }
    },
    "illness.optIn.bullet.journal": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Log episodes and a day-by-day symptom timeline."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erfasse Episoden und einen Symptomverlauf Tag für Tag."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "记录病程，以及逐日症状时间线。"
          }
        }
      }
    },
    "illness.optIn.bullet.retrospective": {
      "extractionState": "manual",
      "localizations": {
        "en": {
