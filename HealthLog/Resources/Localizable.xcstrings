    "biomarker.empty.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Define a biomarker once to reuse its unit and reference range across results."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lege einen Biomarker einmal an, um Einheit und Referenzbereich für alle Werte wiederzuverwenden."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把一个生物标志物定义一次，即可在各项结果中复用它的单位和参考范围。"
          }
        }
      }
    },
    "biomarker.empty.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No biomarkers yet"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch keine Biomarker"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "尚无指标"
          }
        }
      }
    },
    "biomarker.explainer.alt": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "ALT ist ein Leberenzym. Erhöhte Werte können auf eine Belastung oder Reizung der Leber hinweisen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "ALT is a liver enzyme. Elevated values can indicate a strain on or irritation of the liver."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "ALT 是一种肝酶。升高的数值可能提示肝脏承受负担或受到刺激。"
          }
        }
      }
    },
    "biomarker.explainer.apob": {
      "comment": "v1.25 longevity biomarker explainer — ApoB (mirrors server labs.catalog.explainer.apob).",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Apolipoprotein B (ApoB) zählt atherogene Partikel direkt und gilt oft als besserer Risikomarker als LDL-Cholesterin, wenn beide auseinandergehen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apolipoprotein B (ApoB) counts atherogenic particles directly and is often a better risk marker than LDL cholesterol when the two disagree."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "载脂蛋白 B（ApoB）直接计数致动脉粥样硬化的颗粒，当二者不一致时，它常常是比 LDL 胆固醇更好的风险标志物。"
          }
        }
      }
    },
    "biomarker.explainer.ast": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "AST ist ein Enzym, das in Leber und Muskulatur vorkommt. Erhöhte Werte können auf eine Belastung von Leber- oder Muskelgewebe hinweisen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "AST is an enzyme found in the liver and muscle. Elevated values can indicate strain on the liver or muscle tissue."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "AST 是存在于肝脏和肌肉中的一种酶。升高的数值可能提示肝脏或肌肉组织承受负担。"
          }
        }
      }
    },
    "biomarker.explainer.creatinine": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kreatinin ist ein Abbauprodukt, das über die Nieren ausgeschieden wird. Erhöhte Werte können auf eine verminderte Nierenfiltration hinweisen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Creatinine is a waste product filtered by the kidneys. Elevated values can indicate reduced kidney filtration."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "肌酐是由肾脏滤过的一种代谢废物。升高的数值可能提示肾脏滤过下降。"
          }
        }
      }
    },
    "biomarker.explainer.egfr": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die eGFR ist eine Schätzung, wie gut die Nieren das Blut filtern. Niedrigere Werte weisen auf eine verminderte Nierenfunktion hin."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "eGFR is an estimate of how well your kidneys filter blood. Lower values indicate reduced kidney function."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "eGFR 是对你的肾脏滤过血液能力的估计。较低的数值提示肾功能下降。"
          }
        }
      }
    },
    "biomarker.explainer.fasting-glucose": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nüchternglukose ist der Blutzucker nach mehreren Stunden ohne Nahrung. Erhöhte Werte können auf einen veränderten Zuckerstoffwechsel hinweisen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fasting glucose is your blood sugar after several hours without eating. Elevated values can indicate altered glucose metabolism."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "空腹血糖是你数小时没有进食之后的血糖。升高的数值可能提示糖代谢发生了改变。"
          }
        }
      }
    },
    "biomarker.explainer.fasting-insulin": {
      "comment": "v1.25 longevity biomarker explainer — fasting insulin.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nüchtern-Insulin ergänzt den Nüchtern-Blutzucker zur Abschätzung der Insulinresistenz (HOMA-IR). Es wird nach mehrstündigem Fasten gemessen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fasting insulin pairs with fasting glucose to estimate insulin resistance (HOMA-IR). It is measured after several hours without food."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "空腹胰岛素与空腹血糖一起，用来估计胰岛素抵抗（HOMA-IR）。它在数小时没有进食之后测量。"
          }
        }
      }
    },
    "biomarker.explainer.ferritin": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ferritin spiegelt die Eisenspeicher des Körpers wider. Niedrige Werte können auf entleerte Eisenspeicher hinweisen; hohe Werte können bei Entzündungen oder Eisenüberladung auftreten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ferritin reflects your body's stored iron. Low values can indicate depleted iron stores; high values can occur with inflammation or iron overload."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "铁蛋白反映你体内储存的铁。低数值可能提示铁储备已经耗尽；高数值可以出现在炎症或铁过载之时。"
          }
        }
      }
    },
    "biomarker.explainer.folate": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Folsäure ist ein B-Vitamin, das an Zellteilung und Blutbildung beteiligt ist. Niedrige Werte können auf eine Unterversorgung hinweisen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Folate is a B vitamin involved in cell division and blood formation. Low values can indicate an undersupply."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "叶酸是一种参与细胞分裂和造血的 B 族维生素。低数值可能提示供给不足。"
          }
        }
      }
    },
    "biomarker.explainer.ft3": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Freies T3 ist ein aktives Schilddrüsenhormon, das den Stoffwechsel beeinflusst. Es wird zusammen mit TSH und freiem T4 zur Beurteilung der Schilddrüsenfunktion betrachtet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Free T3 is an active thyroid hormone that influences metabolism. It is read together with TSH and free T4 to assess thyroid function."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "游离 T3 是一种影响代谢的活性甲状腺激素。它与 TSH 和游离 T4 一起解读，用以评估甲状腺功能。"
          }
        }
      }
    },
    "biomarker.explainer.ft4": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Freies T4 ist das wichtigste Schilddrüsenhormon im Blut. Es wird zusammen mit dem TSH zur Beurteilung der Schilddrüsenfunktion betrachtet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Free T4 is the main thyroid hormone in your blood. It is interpreted alongside TSH to assess thyroid function."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "游离 T4 是你血液中主要的甲状腺激素。它与 TSH 一起解读，用以评估甲状腺功能。"
          }
        }
      }
    },
    "biomarker.explainer.ggt": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "GGT ist ein Leberenzym. Erhöhte Werte können auf eine Belastung der Leber oder Gallenwege hinweisen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "GGT is a liver enzyme. Elevated values can indicate strain on the liver or bile ducts."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "GGT 是一种肝酶。升高的数值可能提示肝脏或胆管承受负担。"
          }
        }
      }
    },
    "biomarker.explainer.hba1c": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "HbA1c spiegelt den durchschnittlichen Blutzucker der letzten zwei bis drei Monate wider. Höhere Werte zeigen einen höheren mittleren Glukosespiegel an."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "HbA1c reflects your average blood sugar over the past two to three months. Higher values indicate higher average glucose levels."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "HbA1c 反映你过去两到三个月的平均血糖。较高的数值表示更高的平均葡萄糖水平。"
          }
        }
      }
    },
    "biomarker.explainer.hdl": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "HDL-Cholesterin hilft, Cholesterin zurück zur Leber zu transportieren. Höhere Werte gelten allgemein als günstig für das Herz."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "HDL cholesterol helps carry cholesterol back to the liver. Higher values are generally viewed as protective for the heart."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "HDL 胆固醇帮助把胆固醇运回肝脏。较高的数值通常被视为对心脏有保护作用。"
          }
        }
      }
    },
    "biomarker.explainer.hematocrit": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hämatokrit ist der Anteil der roten Blutkörperchen am Blutvolumen. Er wird zusammen mit dem Hämoglobin betrachtet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hematocrit is the proportion of your blood made up of red blood cells. It is read together with hemoglobin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "血细胞比容是红细胞在你的血液中所占的比例。它与血红蛋白一起解读。"
          }
        }
      }
    },
    "biomarker.explainer.hemoglobin": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hämoglobin transportiert Sauerstoff in den roten Blutkörperchen. Niedrige Werte können auf eine Blutarmut hinweisen; hohe Werte können bei Flüssigkeitsmangel oder anderen Faktoren auftreten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hemoglobin carries oxygen in your red blood cells. Low values can indicate anemia; high values can occur with dehydration or other factors."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "血红蛋白在你的红细胞中携带氧气。低数值可能提示贫血；高数值可以出现在脱水或其他因素之时。"
          }
        }
      }
    },
    "biomarker.explainer.homa-ir": {
      "comment": "v1.25 longevity biomarker explainer — HOMA-IR (server-derived; iOS-authored).",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "HOMA-IR ist ein Index, der aus Nüchtern-Blutzucker und Nüchtern-Insulin berechnet wird. Höhere Werte gehen allgemein mit einer stärkeren Insulinresistenz einher."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "HOMA-IR is an index estimated from fasting glucose and fasting insulin. Higher values are generally associated with greater insulin resistance."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "HOMA-IR 是由空腹血糖和空腹胰岛素估计出来的一个指数。较高的数值通常与更强的胰岛素抵抗相关。"
          }
        }
      }
    },
    "biomarker.explainer.hs-crp": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "hs-CRP ist ein empfindlicher Marker für Entzündungen im Körper. Erhöhte Werte können auf eine bestehende Entzündungsaktivität hinweisen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "hs-CRP is a sensitive marker of inflammation in the body. Elevated values can indicate ongoing inflammatory activity."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "hs-CRP 是体内炎症的一个敏感标志物。升高的数值可能提示炎症活动仍在进行。"
          }
        }
      }
    },
    "biomarker.explainer.ldl": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "LDL-Cholesterin transportiert Cholesterin zu den Geweben. Höhere Werte gehen häufig mit einem erhöhten Herz-Kreislauf-Risiko einher."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "LDL cholesterol transports cholesterol to the tissues. Higher values are commonly associated with increased cardiovascular risk."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "LDL 胆固醇把胆固醇运送到组织。较高的数值通常与心血管风险升高相关。"
          }
        }
      }
    },
    "biomarker.explainer.lp-a": {
      "comment": "v1.25 longevity biomarker explainer — Lp(a) (mirrors server labs.catalog.explainer.lp-a).",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lipoprotein(a), Lp(a), ist ein weitgehend vererbter, lebenslanger Risikofaktor und wird meist nur einmal gemessen. Üblicherweise in molaren Einheiten (nmol/L) angegeben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lipoprotein(a), Lp(a), is a largely inherited, lifelong risk factor and is usually measured once. It is typically reported in molar units (nmol/L)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "脂蛋白(a)，即 Lp(a)，是一项在很大程度上由遗传决定、并伴随终身的风险因素，通常只测量一次。它通常以摩尔单位（nmol/L）报告。"
          }
        }
      }
    },
    "biomarker.explainer.omega-3-index": {
      "comment": "v1.25 longevity biomarker explainer — Omega-3 index.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Omega-3-Index ist der Anteil von EPA+DHA in den roten Blutkörperchen. Ein Bereich von 8 bis 12 % wird häufig als kardioprotektiv genannt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The omega-3 index is the share of EPA+DHA in your red blood cells. A range of 8 to 12% is commonly cited as cardioprotective."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "omega-3 指数是 EPA+DHA 在你红细胞中所占的份额。8 至 12% 这一范围常被引为对心脏有保护作用。"
          }
        }
      }
    },
    "biomarker.explainer.platelets": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Thrombozyten sind für die Blutgerinnung wichtig. Werte außerhalb des Bereichs können Blutung und Gerinnung beeinflussen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Platelets help your blood clot. Values outside the range can affect bleeding and clotting."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "血小板帮助你的血液凝固。超出该范围的数值可能影响出血和凝血。"
          }
        }
      }
    },
    "biomarker.explainer.potassium": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kalium ist ein Elektrolyt, der für Nerven- und Muskelfunktion wichtig ist. Werte außerhalb des Bereichs können Herz und Muskeln beeinflussen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Potassium is an electrolyte important for nerve and muscle function. Values outside the range can affect the heart and muscles."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "钾是一种对神经和肌肉功能很重要的电解质。超出该范围的数值可能影响心脏和肌肉。"
          }
        }
      }
    },
    "biomarker.explainer.sodium": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Natrium ist ein Elektrolyt, der den Flüssigkeitshaushalt mitreguliert. Werte außerhalb des Bereichs können mit dem Flüssigkeitshaushalt oder den Nieren zusammenhängen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sodium is an electrolyte that helps regulate fluid balance. Values outside the range can reflect hydration or kidney-related factors."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "钠是一种帮助调节体液平衡的电解质。超出该范围的数值可以反映水分状况，或与肾脏有关的因素。"
          }
        }
      }
    },
    "biomarker.explainer.total-cholesterol": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gesamtcholesterin ist die Summe des im Blut transportierten Cholesterins. Erhöhte Werte können mit einem höheren langfristigen Herz-Kreislauf-Risiko einhergehen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Total cholesterol is the sum of cholesterol carried in your blood. Elevated values can be associated with a higher long-term cardiovascular risk."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "总胆固醇是血液中所运载胆固醇的总和。升高的数值可能与更高的长期心血管风险相关。"
          }
        }
      }
    },
    "biomarker.explainer.transferrin-saturation": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Transferrinsättigung zeigt, wie viel des Eisentransportproteins mit Eisen beladen ist. Sie hilft zusammen mit dem Ferritin, die Eisenversorgung einzuschätzen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Transferrin saturation shows how much of your iron-transport protein is carrying iron. It helps assess iron supply alongside ferritin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "转铁蛋白饱和度显示你的铁转运蛋白有多少正在携带铁。它与铁蛋白一起，帮助评估铁的供给。"
          }
        }
      }
    },
    "biomarker.explainer.triglycerides": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Triglyceride sind die wichtigste Fettart im Blut und eine Energiequelle. Erhöhte Werte können mit Ernährung, Alkohol oder Stoffwechselfaktoren zusammenhängen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Triglycerides are the main type of fat in your blood and a source of energy. Elevated values can be linked to diet, alcohol, or metabolic factors."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "甘油三酯是你血液中主要的脂肪类型，也是一种能量来源。升高的数值可能与饮食、酒精或代谢因素有关。"
          }
        }
      }
    },
    "biomarker.explainer.tsh": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "TSH ist ein Hypophysenhormon, das die Schilddrüse steuert. Werte außerhalb des Bereichs können auf eine Über- oder Unterfunktion der Schilddrüse hinweisen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "TSH is a pituitary hormone that regulates the thyroid. Values outside the range can indicate an over- or underactive thyroid."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "TSH 是调节甲状腺的一种垂体激素。超出该范围的数值可能提示甲状腺过活跃或活动不足。"
          }
        }
      }
    },
    "biomarker.explainer.vitamin-b12": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vitamin B12 wird für die Blutbildung und das Nervensystem benötigt. Niedrige Werte können auf eine langfristige Unterversorgung hinweisen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Vitamin B12 is needed for blood formation and the nervous system. Low values can indicate an undersupply over time."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "维生素 B12 是造血和神经系统所需要的。低数值可能提示长期供给不足。"
          }
        }
      }
    },
    "biomarker.explainer.vitamin-d": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vitamin D (25-OH) spiegelt den Vitamin-D-Status wider, der für Knochen und Immunsystem wichtig ist. Niedrige Werte weisen auf eine Unterversorgung hin."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Vitamin D (25-OH) reflects your vitamin D status, important for bone and immune health. Low values indicate an undersupply."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "维生素 D（25-OH）反映你的维生素 D 状况，对骨骼和免疫健康很重要。低数值提示供给不足。"
          }
        }
      }
    },
    "biomarker.explainer.wbc": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Leukozyten sind Teil des Immunsystems. Werte außerhalb des Bereichs können bei Infektionen, Entzündungen oder anderen Faktoren auftreten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "White blood cells are part of your immune system. Values outside the range can occur with infection, inflammation, or other factors."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "白细胞是你免疫系统的一部分。超出该范围的数值可以出现在感染、炎症或其他因素之时。"
          }
        }
      }
    },
