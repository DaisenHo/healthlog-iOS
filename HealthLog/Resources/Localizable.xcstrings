          }
        }
      }
    },
    "focus.filter.card.body": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Füge HealthLog in den iOS-Einstellungen > Fokus als Filter zu einem beliebigen Fokus (Schlaf, Arbeit …) hinzu. Solange dieser Fokus aktiv ist, hält HealthLog Routine-Erinnerungen zurück (Medikamenten-Backups, den Stimmungs-Hinweis, Vorsorge-Erinnerungen, Nachschub-Hinweise) und optional Coach-Hinweise."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add HealthLog as a filter to any Focus (Sleep, Work …) in iOS Settings > Focus. While that Focus is on, HealthLog holds back routine reminders (medication backups, the mood nudge, preventive-care reminders, low-supply heads-ups) and optionally coach nudges."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 iOS“设置”的“专注模式”中，将 HealthLog 添加为任意专注模式（睡眠、工作等）的过滤条件。启用该专注模式时，HealthLog 会暂停常规提醒（用药备用提醒、心情提醒、预防保健提醒、余量不足提醒），也可暂停助手提醒。"
          }
        }
      }
    },
    "focus.filter.card.footer": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dringende Gesundheitswarnungen wie kritische Medikamenten-Alarme und „Arzt aufsuchen“-Eskalationen werden von einem Fokus-Filter nie zurückgehalten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Urgent health alerts, such as critical medication alarms and “seek care” escalations, are never held back by a Focus filter."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "紧急健康警报（如关键用药闹钟和就医升级提醒）不会被专注模式过滤条件拦截。"
          }
        }
      }
    },
    "focus.filter.card.title": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fokus-Filter"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Focus filter"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "专注模式过滤条件"
          }
        }
      }
    },
    "focus.filter.description": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Solange dieser Fokus aktiv ist, hält HealthLog Routine-Erinnerungen und Coach-Hinweise zurück. Dringende Gesundheitswarnungen kommen weiterhin durch."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
