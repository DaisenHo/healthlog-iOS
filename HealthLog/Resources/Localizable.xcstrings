    "onboarding.trustboundary.body": {
      "comment": "v0.7.0 — Body copy of the trust-boundary acknowledgement sheet. Makes clear that HealthLog cannot guarantee the privacy practices of a self-hosted server.",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du verbindest dich mit deinem eigenen HealthLog-Server. Deine Gesundheitsdaten werden an diesen Host gesendet und dort gespeichert. Stelle sicher, dass du dem Betreiber dieses Servers vertraust."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You are connecting to your own HealthLog server. Your health data will be sent to and stored on this host. Make sure you trust whoever runs this server."
          }
        }
      }
    },
